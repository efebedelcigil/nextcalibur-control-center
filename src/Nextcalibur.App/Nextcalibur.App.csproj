<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection, for one thing: toast notifications with
         a button, which the tray's balloon cannot carry. Everything else in
         this project is plain WPF; the floor stays at 1809. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Framework-dependent: the .NET desktop runtime is a dependency, not
         cargo.

         It was carried inside the package from 11 September 2026, and for a
         good reason: Velopack's own runtime bootstrap was watched failing
         silently on a clean Windows - the prompt appeared, the progress bar
         never moved, the Finish button was clickable anyway, and somebody
         was left with no application and nothing to read. The network was
         never the problem; the same runtime downloaded directly at
         4.13 MB/s in the same sandbox.

         What that decision could not price: nothing on a machine patches a
         runtime that lives inside an application. 0.5.3 carried 8.0.30 for
         as long as it stayed installed, five days after 8.0.31 fixed five
         security holes, and the only cure was another release - for every
         .NET patch, for ever.

         So the runtime is a dependency now (DotNetRuntimeDependency), and
         neither thing that failed then is in the way: the wizard installs
         it itself the way it installs PawnIO - Microsoft's own installer,
         checked against Microsoft's published hash and signature - and the
         application keeps it current afterwards through the same check,
         button and notification as everything else. Windows patches a
         shared runtime by itself as well, which is the point.

         RollForward=Major: if the 10.0 runtime is ever gone and a newer one
         is there, the application runs on that rather than not at all.

         .NET 10 since 0.5.9: .NET 8 left support on 10 November 2026, and
         10 is the long-term release, supported until November 2028. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RollForward>Major</RollForward>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nextcalibur</AssemblyName>
    <RootNamespace>Nextcalibur.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Nextcalibur Control Center</Product>
    <!-- What the file's Details tab shows. The name a UAC or SmartScreen
         prompt shows comes from a code-signing certificate instead; without
         one it says "Unknown" whatever is written here (docs/RELEASING.md). -->
    <Company>Efe Bedelcigil</Company>
    <Authors>Efe Bedelcigil</Authors>
    <Copyright>Efe Bedelcigil, MIT licence</Copyright>
    <Version>0.5.10</Version>
    <StartupObject>Nextcalibur.App.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- WFAC010 is a WinForms analyzer asking for ApplicationHighDpiMode instead of
         the manifest's dpiAware block. This is a WPF application; the manifest is
         the only route to PerMonitorV2 here, and WinForms is enabled only for the
         tray icon. See app.manifest. WFO0003 is the same analyzer under its
         .NET 10 name. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- A custom Main is needed so Velopack's hooks run before any UI exists.
       WPF would otherwise generate its own entry point from App.xaml, so App.xaml
       is compiled as a Page and the entry point is declared explicitly above. -->
  <ItemGroup>
    <ProjectReference Include="..\Nextcalibur.Core\Nextcalibur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- UseWindowsForms is on for the tray icon only, which makes several type
       names ambiguous with WPF. Bind the WPF ones project-wide so call sites
       stay readable. -->
  <ItemGroup>
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.MessageBoxButton" Alias="MessageBoxButton" />
    <Using Include="System.Windows.MessageBoxImage" Alias="MessageBoxImage" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Controls.Control" Alias="Control" />
    <Using Include="System.Windows.Controls.Image" Alias="Image" />
    <Using Include="System.Windows.Size" Alias="Size" />
    <Using Include="System.Windows.Point" Alias="Point" />
    <Using Include="System.Windows.Input.MouseEventArgs" Alias="MouseEventArgs" />
    <Using Include="System.Windows.Input.MouseButtonEventArgs" Alias="MouseButtonEventArgs" />
    <Using Include="System.Windows.Controls.RadioButton" Alias="RadioButton" />
    <Using Include="System.Windows.Media.Brushes" Alias="Brushes" />
    <Using Include="System.Windows.Media.Brush" Alias="Brush" />
    <Using Include="System.Windows.Media.Pen" Alias="Pen" />
    <Using Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-48.png" />
    <Resource Include="Assets\logo-96.png" />
    <Resource Include="Assets\logo-text-300.png" />
  </ItemGroup>

</Project>


