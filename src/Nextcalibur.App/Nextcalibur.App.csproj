<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Framework-dependent keeps the download at a few megabytes instead of
         seventy. The installer declares a dependency on the .NET 8 desktop
         runtime and fetches it only if the machine does not already have it. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nextcalibur</AssemblyName>
    <RootNamespace>Nextcalibur.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Nextcalibur Control Center</Product>
    <Company>Nextcalibur</Company>
    <Version>0.1.0</Version>
    <StartupObject>Nextcalibur.App.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- A custom Main is needed so Velopack's hooks run before any UI exists.
       WPF would otherwise generate its own entry point from App.xaml, so App.xaml
       is compiled as a Page and the entry point is declared explicitly above. -->
  <ItemGroup>
    <ProjectReference Include="..\Nextcalibur.Core\Nextcalibur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- UseWindowsForms is on for the tray icon only, which makes several type
       names ambiguous with WPF. Bind the WPF ones project-wide so call sites
       stay readable. -->
  <ItemGroup>
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.MessageBoxButton" Alias="MessageBoxButton" />
    <Using Include="System.Windows.MessageBoxImage" Alias="MessageBoxImage" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
