<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Self-contained, and it has to be.
         Framework-dependent kept the download at a few megabytes, on the
         understanding that the installer would fetch the .NET desktop runtime
         when a machine lacked it. Watched on a clean Windows for the first time
         on 11 September 2026, it does not: the prompt appears, the progress bar
         never moves, and the Finish button is clickable anyway - so somebody is
         told nothing is wrong and then cannot find the application they just
         installed. The network was not the problem; the same runtime downloads
         directly at 4.13 MB/s in the same sandbox.
         Carrying the runtime removes the step that fails. Updates stay small:
         the runtime files do not change between versions, so they cost nothing
         in a delta. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nextcalibur</AssemblyName>
    <RootNamespace>Nextcalibur.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Nextcalibur Control Center</Product>
    <Company>Nextcalibur</Company>
    <Version>0.5.0</Version>
    <StartupObject>Nextcalibur.App.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- WFAC010 is a WinForms analyzer asking for ApplicationHighDpiMode instead of
         the manifest's dpiAware block. This is a WPF application; the manifest is
         the only route to PerMonitorV2 here, and WinForms is enabled only for the
         tray icon. See app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- A custom Main is needed so Velopack's hooks run before any UI exists.
       WPF would otherwise generate its own entry point from App.xaml, so App.xaml
       is compiled as a Page and the entry point is declared explicitly above. -->
  <ItemGroup>
    <ProjectReference Include="..\Nextcalibur.Core\Nextcalibur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- UseWindowsForms is on for the tray icon only, which makes several type
       names ambiguous with WPF. Bind the WPF ones project-wide so call sites
       stay readable. -->
  <ItemGroup>
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.MessageBoxButton" Alias="MessageBoxButton" />
    <Using Include="System.Windows.MessageBoxImage" Alias="MessageBoxImage" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Controls.Control" Alias="Control" />
    <Using Include="System.Windows.Controls.Image" Alias="Image" />
    <Using Include="System.Windows.Size" Alias="Size" />
    <Using Include="System.Windows.Point" Alias="Point" />
    <Using Include="System.Windows.Input.MouseEventArgs" Alias="MouseEventArgs" />
    <Using Include="System.Windows.Input.MouseButtonEventArgs" Alias="MouseButtonEventArgs" />
    <Using Include="System.Windows.Controls.RadioButton" Alias="RadioButton" />
    <Using Include="System.Windows.Media.Brushes" Alias="Brushes" />
    <Using Include="System.Windows.Media.Brush" Alias="Brush" />
    <Using Include="System.Windows.Media.Pen" Alias="Pen" />
    <Using Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>


