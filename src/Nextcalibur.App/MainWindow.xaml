                                                        HorizontalAlignment="Stretch" Margin="36,0,36,0" CornerRadius="2" />
                                                <!-- Center Power Shield Indicator -->
                                                <Path Data="M 0,0 L 12,0 L 6,8 Z" Fill="{DynamicResource Muted}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                                            </Grid>

                                            <!-- Recessed Keyboard Well: Houses 3 Backlight Zones -->
                                            <Border Grid.Row="1" Background="#0A0B0E" BorderBrush="#161822"
                                                    BorderThickness="1" CornerRadius="4" Padding="3">
