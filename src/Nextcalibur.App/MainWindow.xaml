                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TourLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Square Corners (0px) -->
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{DynamicResource TitleBarBackground}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Official Nextcalibur LogoMark + Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/logo-96.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{DynamicResource S.Caption.Wordmark}"
                               Style="{DynamicResource WordmarkTextStyle}" />
                </StackPanel>

                <!-- Center/Right: Abstract Copper Circuit Header Artwork with Gradient Fade -->
                <Viewbox Grid.Column="2" Stretch="UniformToFill" Width="360" Height="36"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Viewbox.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                            <GradientStop Color="#FF000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Viewbox.OpacityMask>
                    <Image Source="{DynamicResource HeaderCircuitImage}" Width="380" Height="36" />
                </Viewbox>

                <!-- Three-way Theme Setting: Dark / Light / Follow-System -->
                <Border x:Name="ThemeSwitch" Grid.Column="3" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="4" Padding="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeDark" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="Dark" Checked="OnThemeChanged" ToolTip="{DynamicResource S.Caption.ThemeDark}">
                            <Path Data="{DynamicResource IconThemeDark}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeLight" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="Light" Checked="OnThemeChanged" ToolTip="{DynamicResource S.Caption.ThemeLight}">
                            <Path Data="{DynamicResource IconThemeLight}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeSystem" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="System" Checked="OnThemeChanged" ToolTip="{DynamicResource S.Caption.ThemeSystem}">
                            <Path Data="{DynamicResource IconThemeSystem}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right: Caption Buttons (Tour, Minimise, Hide to Tray, Close) (§20) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="TourButton" Style="{DynamicResource CaptionButton}" Click="OnTourClick"
                            Tag="{DynamicResource IconTour}" ToolTip="{DynamicResource S.Caption.Tour}" />
                    <Button x:Name="MinimiseButton" Style="{DynamicResource CaptionButton}" Click="OnMinimiseClick"
                            Tag="{DynamicResource IconMinimise}" ToolTip="{DynamicResource S.Caption.Minimise}" />
                    <Button x:Name="HideToTrayButton" Style="{DynamicResource CaptionButton}" Click="OnMinimiseToTrayClick"
                            Tag="{DynamicResource IconMinimiseToTray}" ToolTip="{DynamicResource S.Caption.HideToTray}" />
                    <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}" Click="OnCloseClick"
                            Tag="{DynamicResource IconClose}" ToolTip="{DynamicResource S.Caption.Close}" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail (4 items: System, Power Mode, Display, Lighting) -->
                <Border Grid.Column="0" Background="{DynamicResource RailBackground}"
                        BorderBrush="{DynamicResource RailBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Rail Wordmark (Master: logo-text.png, Downsample: logo-text-300.png, 2.18:1) -->
                        <Image Grid.Row="0" Source="/Assets/logo-text-300.png"
                               Width="72" Height="33"
                               Margin="0,14,0,14"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Navigation Items Stack -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <!-- 1. System Dashboard -->
                            <RadioButton x:Name="NavSystem" Style="{DynamicResource NavItem}" Tag="{DynamicResource S.Nav.System}"
                                         GroupName="Nav" IsChecked="True" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavSystem}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 2. Power Mode -->
                            <RadioButton x:Name="NavPower" Style="{DynamicResource NavItem}" Tag="{DynamicResource S.Nav.Power}"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavPower}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 3. Display Mode -->
                            <RadioButton x:Name="NavDisplay" Style="{DynamicResource NavItem}" Tag="{DynamicResource S.Nav.Display}"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavDisplay}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 4. LED / Lighting Control -->
                            <RadioButton x:Name="NavLighting" Style="{DynamicResource NavItem}" Tag="{DynamicResource S.Nav.Lighting}"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavLighting}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 5. Settings -->
                            <RadioButton x:Name="NavSettings" Style="{DynamicResource NavItem}" Tag="{DynamicResource S.Nav.Settings}"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavSettings}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>
                        </StackPanel>

                        <!-- Rail Bottom: Update & Log Buttons + Version Label (§19) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="5,0,5,12">
                            <Button x:Name="UpdateNowButton" Click="OnUpdateNowClick"
                                    IsEnabled="False"
                                    Content="{DynamicResource S.Corner.UpToDate}"
                                    Style="{StaticResource RailUpdateButtonStyle}"
                                    Margin="0,0,0,5"
                                    ToolTip="{DynamicResource S.Corner.UpdateTooltip}" />

                            <Button x:Name="OpenLogButton" Click="OnOpenLogClick"
                                    Content="{DynamicResource S.Corner.OpenLog}"
                                    Style="{StaticResource RailSecondaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    ToolTip="{DynamicResource S.Corner.OpenLogTooltip}" />

                            <TextBlock x:Name="VersionText"
                                       Style="{DynamicResource StatusTextStyle}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center" />

                            <Button x:Name="LanguageButton" Click="OnLanguageClick"
                                    Content="{DynamicResource S.Corner.Language}"
                                    Style="{StaticResource RailSecondaryButtonStyle}"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <Grid Grid.Column="1" Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= PAGE: SYSTEM ================= -->
                    <Grid x:Name="PageSystem" Grid.Column="0" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Top System Mode Tabs -->
                            <RowDefinition Height="*" />    <!-- Dual Fan Gauges & Telemetry -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: System Mode Tabs (Office, Gaming, Performance) & Live System Mode Note -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <!-- 1. Office Mode -->
                                <RadioButton x:Name="ModeOffice" Style="{DynamicResource SystemModeTab}"
                                             Tag="Office" GroupName="Mode" Checked="OnSystemModeChanged">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconModeOffice}" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{DynamicResource S.System.Office}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- 2. Gaming Mode -->
                                <RadioButton x:Name="ModeGaming" Style="{DynamicResource SystemModeTab}"
                                             Tag="Gaming" GroupName="Mode" Checked="OnSystemModeChanged">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconModeGaming}" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{DynamicResource S.System.Gaming}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- 3. High Performance Mode -->
                                <RadioButton x:Name="ModePerformance" Style="{DynamicResource SystemModeTab}"
                                             Tag="Performance" GroupName="Mode" Checked="OnSystemModeChanged">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconModePerformance}" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{DynamicResource S.System.Performance}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- SystemModeNote: collapsed by default, shown when no mode is active -->
                            <TextBlock x:Name="SystemModeNote" Style="{DynamicResource StatusTextStyle}"
                                       Margin="2,8,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Row 1: Left/Center: Dual Fan Gauges, Temperatures & Hardware Monitoring Header -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Status Subtitle (Keeps title and subtitle line as requested in §15) -->
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource S.System.HardwareMonitoring}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}" />
                                <TextBlock x:Name="SubtitleText" Style="{DynamicResource StatusTextStyle}"
                                           Text="{DynamicResource S.System.SubtitlePlaceholder}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Overheat / Warning Banner -->
                            <Border x:Name="Banner" Grid.Row="1" Style="{DynamicResource Card}"
                                    Margin="0,0,0,10" Visibility="Collapsed" BorderBrush="{DynamicResource Warn}">
                                <StackPanel>
                                    <TextBlock x:Name="BannerTitle" Foreground="{DynamicResource Warn}"
                                               FontWeight="Bold" FontSize="13" />
                                    <TextBlock x:Name="BannerBody" Style="{DynamicResource StatusTextStyle}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Fan Speed Gauges Card -->
                            <Border Grid.Row="2" Style="{DynamicResource Card}" VerticalAlignment="Stretch">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Fan & Temp Column -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <c:FanGauge x:Name="CpuFanGauge" Width="146" Height="146"
                                                    Value="{Binding Text, ElementName=CpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                    BladeBrush="{DynamicResource Accent}"
                                                    ArcBrush="{DynamicResource Accent}"
                                                    TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                    HubBrush="{DynamicResource PanelBackground}"
                                                    HubBorderBrush="{DynamicResource Line}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="CpuFan" Text="--"
                                                           Style="{DynamicResource Value}" FontSize="17"
                                                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource S.System.CpuFan}" Style="{DynamicResource Label}" FontSize="10"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </c:FanGauge>

                                        <Border Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="4" Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="150">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource S.System.CpuTemp}" Style="{DynamicResource Label}"
                                                           HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Text, ElementName=CpuTemp}"
                                                               Foreground="{Binding Foreground, ElementName=CpuTemp}"
                                                               Style="{DynamicResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text, ElementName=CpuClock}" Style="{DynamicResource Label}"
                                                               Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"
                                                               VerticalAlignment="Bottom" Margin="8,0,0,3" />
                                                </StackPanel>
                                                <TextBlock x:Name="CpuName" Style="{DynamicResource Label}"
                                                           Foreground="{DynamicResource Muted}" FontSize="10.5"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Vertical Divider -->
                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" Margin="10,20" />

                                    <!-- GPU Fan & Temp Column -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <c:FanGauge x:Name="GpuFanGauge" Width="146" Height="146"
                                                    Value="{Binding Text, ElementName=GpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                    BladeBrush="{DynamicResource Accent}"
                                                    ArcBrush="{DynamicResource Accent}"
                                                    TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                    HubBrush="{DynamicResource PanelBackground}"
                                                    HubBorderBrush="{DynamicResource Line}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="GpuFan" Text="--"
                                                           Style="{DynamicResource Value}" FontSize="17"
                                                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource S.System.GpuFan}" Style="{DynamicResource Label}" FontSize="10"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </c:FanGauge>

                                        <Border Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="4" Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="150">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource S.System.GpuTemp}" Style="{DynamicResource Label}"
                                                           HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Text, ElementName=GpuTemp}"
                                                               Foreground="{Binding Foreground, ElementName=GpuTemp}"
                                                               Style="{DynamicResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text, ElementName=GpuClock}" Style="{DynamicResource Label}"
                                                               Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"
                                                               VerticalAlignment="Bottom" Margin="8,0,0,3" />
                                                </StackPanel>
                                                <TextBlock x:Name="GpuName" Style="{DynamicResource Label}"
                                                           Foreground="{DynamicResource Muted}" FontSize="10.5"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE: POWER ================= -->
                    <Grid x:Name="PagePower" Grid.Column="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Header -->
                            <RowDefinition Height="Auto" /> <!-- 4 Power Mode Option Cards -->
                            <RowDefinition Height="*" />    <!-- Status and Repair Bar -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="{DynamicResource S.Power.Title}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,16" />

                        <!-- Four Windows Power Overlay Cards in a Row (None checked by default) -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Best Power Efficiency -->
                            <RadioButton x:Name="PowerModeEfficiency" Grid.Column="0"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Efficiency" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerSaver}" Width="46" Height="46" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Power.Efficiency}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock x:Name="PowerModeEfficiencyText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="15"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Balanced -->
                            <RadioButton x:Name="PowerModeBalanced" Grid.Column="1"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Balanced" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerBalanced}" Width="46" Height="46" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Power.Balanced}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock x:Name="PowerModeBalancedText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="15"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Better Performance -->
                            <RadioButton x:Name="PowerModeBetter" Grid.Column="2"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Better" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="2,0,2,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerPerformance}" Width="46" Height="46" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Power.Better}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock x:Name="PowerModeBetterText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="15"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Best Performance -->
                            <RadioButton x:Name="PowerModeBest" Grid.Column="3"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Best" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="4,0,0,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerBest}" Width="46" Height="46" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Power.Best}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock x:Name="PowerModeBestText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="15"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- Diagnosis and Repair Strip -->
                        <Border Grid.Row="2" Style="{DynamicResource Card}">
                            <Grid VerticalAlignment="Center" Margin="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource S.Power.CurrentMode}" Style="{DynamicResource Label}" />
                                    <TextBlock x:Name="OverlayState" Foreground="{DynamicResource Good}"
                                               FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                               Text="{DynamicResource S.Power.Checking}" />
                                    <TextBlock x:Name="OverlayDetail" Style="{DynamicResource StatusTextStyle}"
                                               Margin="0,6,16,0" TextWrapping="Wrap" LineHeight="17" />
                                </StackPanel>

                                <Button x:Name="FixButton" Grid.Column="1" Content="{DynamicResource S.Power.Repair}"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="OnRepairClick" Padding="18,8" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PAGE: DISPLAY ================= -->
                    <Grid x:Name="PageDisplay" Grid.Column="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="{DynamicResource S.Display.Title}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,20" />

                        <!-- Three GPU Mode Option Cards in a Row (None checked by default) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- 1. Discrete GPU -->
                            <RadioButton x:Name="ModeDiscrete" Style="{DynamicResource GpuOptionCard}"
                                         Width="184" Height="220" Margin="5,0"
                                         Tag="Discrete" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuDiscrete}" Width="64" Height="64" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Display.Discrete}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock Text="{DynamicResource S.Display.DiscreteDesc}" TextWrapping="Wrap" TextAlignment="Center"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock x:Name="ModeDiscreteNote" Text="{DynamicResource S.Display.DiscreteFromUmaNote}"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. MS Hybrid -->
                            <RadioButton x:Name="ModeHybrid" Style="{DynamicResource GpuOptionCard}"
                                         Width="184" Height="220" Margin="5,0"
                                         Tag="Hybrid" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuHybrid}" Width="64" Height="64" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Display.Hybrid}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock Text="{DynamicResource S.Display.HybridDesc}" TextWrapping="Wrap" TextAlignment="Center"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock x:Name="ModeHybridNote"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. UMA Mode -->
                            <RadioButton x:Name="ModeUma" Style="{DynamicResource GpuOptionCard}"
                                         Width="184" Height="220" Margin="5,0"
                                         Tag="Uma" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuUma}" Width="64" Height="64" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Display.Uma}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock Text="{DynamicResource S.Display.UmaDesc}" TextWrapping="Wrap" TextAlignment="Center"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock x:Name="ModeUmaNote" Text="{DynamicResource S.Display.UmaFromDiscreteNote}"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Explanation & Status Area -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,12,0,0">
                            <!-- Restart pending notification (differing detected vs stored firmware mode) -->
                            <TextBlock x:Name="GpuRestartPending" Style="{DynamicResource StatusTextStyle}"
                                       Foreground="{DynamicResource Warn}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" />

                            <!-- Shown only while the cards are locked after a switch: a countdown,
                                 so ten seconds of disabled cards read as 'settling' rather than 'broken'. -->
                            <TextBlock x:Name="GpuSettling" Style="{DynamicResource StatusTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"
                                       FontWeight="SemiBold" Visibility="Collapsed" />

                            <!-- Full-width explanation -->
                            <TextBlock x:Name="GpuModeDetail" Style="{DynamicResource StatusTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" LineHeight="19" />
                        </StackPanel>
                    </Grid>

                    <!-- ================= PAGE: LIGHTING ================= -->
                    <Grid x:Name="PageLighting" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="316" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Zone Tabs, Realistic G870 Laptop Hardware Keyboard Backlight Preview, Profile Row -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Zone Selection Tabs -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="TabZoneA" Style="{DynamicResource ZoneTab}" Content="{DynamicResource S.Lighting.ZoneA}"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Left" />
                                <RadioButton x:Name="TabZoneB" Style="{DynamicResource ZoneTab}" Content="{DynamicResource S.Lighting.ZoneB}"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Middle" />
                                <RadioButton x:Name="TabZoneC" Style="{DynamicResource ZoneTab}" Content="{DynamicResource S.Lighting.ZoneC}"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Right" />
                            </StackPanel>

                            <!-- Authentic Casper Excalibur G870 Laptop Chassis & 3-Zone Keyboard Backlight Preview -->
                            <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="8">
                                <Grid VerticalAlignment="Center">
                                    <!-- Laptop Deck Enclosure (Metallic anodized titanium/silver finish with bevels) -->
                                    <Border CornerRadius="8" Padding="10,8,10,8"
                                            BorderThickness="1.5" BorderBrush="{DynamicResource CardBorder}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2C2F38" Offset="0.0" />
                                                <GradientStop Color="#202229" Offset="0.25" />
                                                <GradientStop Color="#181A20" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /> <!-- Top Exhaust Vents & Power Shield Bar -->
                                                <RowDefinition Height="Auto" /> <!-- Recessed Keyboard Well with 3 Zones -->
                                                <RowDefinition Height="Auto" /> <!-- Palm Rest & Centered Touchpad -->
                                            </Grid.RowDefinitions>

                                            <!-- Top Vent Grille & Power Shield -->
                                            <!-- Top Vent Grille & Power Shield Bar -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <!-- Dark Red Accent Grille Strip -->
                                                <Border Background="#8A180E" Height="4" VerticalAlignment="Top"
                                                        HorizontalAlignment="Stretch" Margin="36,0,36,0" CornerRadius="2" />
                                            </Grid>

                                            <!-- Recessed Keyboard Well: Houses 3 Authentic Hardware Vector Backlight Zones -->
                                            <Border Grid.Row="1" Background="#0A0B0E" BorderBrush="#161822"
                                                    BorderThickness="1" CornerRadius="5" Padding="6,8,6,6"
                                                    HorizontalAlignment="Center">
                                                <Grid Width="457" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Live Zone Colour Providers (Contract: code-behind assigns .Background and .BorderBrush) -->
                                                    <Border x:Name="PreviewA" Visibility="Collapsed" />
                                                    <Border x:Name="PreviewB" Visibility="Collapsed" />
                                                    <Border x:Name="PreviewC" Visibility="Collapsed" />

                                                    <!-- Zone A: Left Keyboard Vector -->
                                                    <RadioButton Style="{StaticResource ZoneStyleA}"
                                                                 IsChecked="{Binding IsChecked, ElementName=TabZoneA, Mode=TwoWay}"
                                                                 GroupName="DirectKeyboardZonePicker" />

                                                    <!-- Zone B: Middle Keyboard Vector -->
                                                    <RadioButton Style="{StaticResource ZoneStyleB}"
                                                                 IsChecked="{Binding IsChecked, ElementName=TabZoneB, Mode=TwoWay}"
                                                                 GroupName="DirectKeyboardZonePicker" />

                                                    <!-- Zone C: Right Keyboard Vector -->
                                                    <RadioButton Style="{StaticResource ZoneStyleC}"
                                                                 IsChecked="{Binding IsChecked, ElementName=TabZoneC, Mode=TwoWay}"
                                                                 GroupName="DirectKeyboardZonePicker" />
                                                </Grid>
                                            </Border>

                                            <!-- Palm Rest & Precision Touchpad -->
                                            <Border Grid.Row="2" Height="52" Margin="0,6,0,0">
                                                <Border Width="154" Height="44" HorizontalAlignment="Center"
                                                        CornerRadius="4" BorderThickness="1.2"
                                                        BorderBrush="#FFFFFF" Background="#161820" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bottom: Lighting Profile Buttons (Office, Gaming, Performance, User Define) -->
                            <StackPanel x:Name="ProfileRow" Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,10,0,0">
                                <RadioButton x:Name="ProfOffice" Style="{DynamicResource ProfileButton}" Content="{DynamicResource S.Lighting.ProfOffice}"
                                             Tag="Office" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfGaming" Style="{DynamicResource ProfileButton}" Content="{DynamicResource S.Lighting.ProfGaming}"
                                             Tag="Gaming" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfPerformance" Style="{DynamicResource ProfileButton}" Content="{DynamicResource S.Lighting.ProfPerformance}"
                                             Tag="Performance" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfUser" Style="{DynamicResource ProfileButton}" Content="{DynamicResource S.Lighting.ProfUser}"
                                             Tag="UserDefine" GroupName="Profile" Checked="OnProfileChecked" />
                            </StackPanel>
                        </Grid>

                        <!-- Right: Master Switches, Effects Grid, Color Wheel, Brightness Slider -->
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master switches -->
                                    <RowDefinition Height="Auto" /> <!-- Divider -->
                                    <RowDefinition Height="Auto" /> <!-- Effects Panel -->
                                    <RowDefinition Height="*" />    <!-- Color Wheel & Brightness Slider -->
                                </Grid.RowDefinitions>

                                <!-- 1. Master Switches (LED on/off, Select all, Reload) -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LED on/off -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <ToggleButton x:Name="LedPower" Style="{DynamicResource Pill}"
                                                      Click="OnLedPowerToggled" />
                                        <TextBlock Text="{DynamicResource S.Lighting.LedPower}" Style="{DynamicResource Label}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Select all -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <ToggleButton x:Name="SelectAll" Style="{DynamicResource Pill}"
                                                      Click="OnSelectAllToggled" />
                                        <TextBlock Text="{DynamicResource S.Lighting.SelectAll}" Style="{DynamicResource Label}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Reload Button -->
                                    <Button x:Name="ReloadButton" Grid.Column="2" Click="OnReloadClick"
                                            VerticalAlignment="Top" Margin="0,2,4,0" ToolTip="{DynamicResource S.Lighting.Reload}">
                                        <Path Data="{DynamicResource IconReload}" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeEndLineCap="Round" />
                                    </Button>
                                 </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="0,6,0,10" />

                                <!-- 2. Lighting Effect Selection (Static, Breathing, Blink, Heartbeat, Cycle, Wave) -->
                                <UniformGrid x:Name="EffectPanel" Grid.Row="2" Columns="3" Margin="0,0,0,6">
                                    <RadioButton x:Name="FxStatic" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectStatic}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxStatic}" />
                                    <RadioButton x:Name="FxBreathing" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectBreathing}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxBreathing}" />
                                    <RadioButton x:Name="FxBlink" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectBlink}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxBlink}" />
                                    <RadioButton x:Name="FxHeartbeat" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectHeartbeat}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxHeartbeat}" />
                                    <RadioButton x:Name="FxCycle" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectCycle}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxCycle}" />
                                    <RadioButton x:Name="FxWave" Style="{DynamicResource EffectButton}" Content="{DynamicResource S.Lighting.EffectWave}"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxWave}" />
                                </UniformGrid>

                                <!-- 3. Polar Color Wheel & Brightness Slider -->
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Color Wheel & Hint Message -->
                                    <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <c:ColourWheel x:Name="Wheel" Width="140" Height="140"
                                                       ColourPicked="OnColourPicked" />
                                        <TextBlock x:Name="WheelHint" Style="{DynamicResource Label}" Margin="0,4,0,0"
                                                   Text="{DynamicResource S.Lighting.FixedCycleHint}" Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Brightness Slider & Readout -->
                                    <StackPanel Grid.Row="1" Margin="6,6,6,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource S.Lighting.Brightness}" Style="{DynamicResource Label}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BrightnessValue" Text="100%"
                                                       Style="{DynamicResource Value}" FontSize="13"
                                                       Foreground="{DynamicResource Ink}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                ValueChanged="OnBrightnessChanged" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PAGE: SETTINGS ================= -->
                    <Grid x:Name="PageSettings" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel HorizontalAlignment="Stretch">
                                <!-- Section 0: Tools (§21a, §21b) -->
                                <TextBlock Text="{DynamicResource S.Settings.GroupTools}" Style="{DynamicResource PanelHeaderTextStyle}" Margin="4,0,0,6" />
                                <Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}" Margin="0,0,0,10" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0, Col 0: 1. WinUtil -->
                                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,4,16,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource S.Settings.WinUtilTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.WinUtilDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="15" />
                                            </StackPanel>
                                            <Button x:Name="SettingWinUtilButton" Grid.Column="1" Content="{DynamicResource S.Settings.WinUtilButton}"
                                                    MinWidth="110" Height="28" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Row 0, Col 1: Vertical Divider Top -->
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Line}" />

                                        <!-- Row 0, Col 2: 2. Drivers -->
                                        <Grid Grid.Row="0" Grid.Column="2" Margin="16,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource S.Settings.DriversTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.DriversDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="15" />
                                            </StackPanel>
                                            <Button x:Name="SettingDriversButton" Grid.Column="1" Content="{DynamicResource S.Settings.DriversButton}"
                                                    MinWidth="110" Height="28" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Row 1, Col 0-2: Horizontal Divider -->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource Line}" Margin="0,4" />

                                        <!-- Row 2, Col 0: 3. Issues -->
                                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,6,16,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource S.Settings.ReportTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.ReportDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="15" />
                                            </StackPanel>
                                            <Button x:Name="SettingReportButton" Grid.Column="1" Content="{DynamicResource S.Settings.ReportButton}"
                                                    MinWidth="110" Height="28" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Row 2, Col 1: Vertical Divider Bottom -->
                                        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Line}" />

                                        <!-- Row 2, Col 2: 4. Privacy (§21b) -->
                                        <Grid Grid.Row="2" Grid.Column="2" Margin="16,6,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource S.Settings.PrivacyTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.PrivacyDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="15" />
                                            </StackPanel>
                                            <Button x:Name="SettingPrivacyButton" Grid.Column="1" Content="{DynamicResource S.Settings.PrivacyButton}"
                                                    MinWidth="110" Height="28" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Section 1: Behaviour -->
                                <TextBlock Text="{DynamicResource S.Settings.GroupBehaviour}" Style="{DynamicResource PanelHeaderTextStyle}" Margin="4,0,0,6" />
                                <Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}" Margin="0,0,0,10" Padding="16,8">
                                    <StackPanel>
                                        <!-- SettingStartWithWindows -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.StartWithWindowsTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.StartWithWindowsDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleButton x:Name="SettingStartWithWindows" Grid.Column="1"
                                                          Style="{DynamicResource Pill}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,5" />

                                        <!-- SettingOfficeOnBattery -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.OfficeOnBatteryTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.OfficeOnBatteryDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleButton x:Name="SettingOfficeOnBattery" Grid.Column="1"
                                                          Style="{DynamicResource Pill}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Readings -->
                                <TextBlock Text="{DynamicResource S.Settings.GroupReadings}" Style="{DynamicResource PanelHeaderTextStyle}" Margin="4,0,0,6" />
                                <Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}" Margin="0,0,0,10" Padding="16,8">
                                    <StackPanel>
                                        <!-- SettingOverheatWarning -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.OverheatWarningTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.OverheatWarningDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleButton x:Name="SettingOverheatWarning" Grid.Column="1"
                                                          Style="{DynamicResource Pill}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,5" />

                                        <!-- SettingInterval -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.IntervalTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.IntervalDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    CornerRadius="4" Padding="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="SettingInterval1" Style="{DynamicResource SegmentedRadioButtonStyle}"
                                                                 GroupName="Interval" Content="{DynamicResource S.Settings.Interval1}" />
                                                    <RadioButton x:Name="SettingInterval2" Style="{DynamicResource SegmentedRadioButtonStyle}"
                                                                 GroupName="Interval" Content="{DynamicResource S.Settings.Interval2}" />
                                                    <RadioButton x:Name="SettingInterval5" Style="{DynamicResource SegmentedRadioButtonStyle}"
                                                                 GroupName="Interval" Content="{DynamicResource S.Settings.Interval5}" />
                                                    <RadioButton x:Name="SettingInterval10" Style="{DynamicResource SegmentedRadioButtonStyle}"
                                                                 GroupName="Interval" Content="{DynamicResource S.Settings.Interval10}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: Updates -->
                                <TextBlock Text="{DynamicResource S.Settings.GroupUpdates}" Style="{DynamicResource PanelHeaderTextStyle}" Margin="4,0,0,6" />
                                <Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}" Margin="0,0,0,10" Padding="16,8">
                                    <StackPanel>
                                        <!-- SettingAutoCheckUpdates -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.AutoCheckTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.AutoCheckDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleButton x:Name="SettingAutoCheckUpdates" Grid.Column="1"
                                                          Style="{DynamicResource Pill}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,5" />

                                        <!-- SettingAutoInstallUpdates -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.AutoInstallTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.AutoInstallDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ToggleButton x:Name="SettingAutoInstallUpdates" Grid.Column="1"
                                                          Style="{DynamicResource Pill}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,5" />

                                        <!-- SettingCheckNowButton -->
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{DynamicResource S.Settings.CheckNowTitle}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}" />
                                                <TextBlock Text="{DynamicResource S.Settings.CheckNowDesc}"
                                                           Style="{DynamicResource StatusTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="SettingCheckNowButton" Grid.Column="1"
                                                    Content="{DynamicResource S.Settings.CheckNowButton}" MinWidth="90" Height="28"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Column: CPU & GPU Segmented Telemetry + Memory & Disk Conditions (System, Power, Display; hidden on Lighting) -->
                    <Grid Grid.Column="1" Width="280" Margin="16,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NavLighting}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NavSettings}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panel 1: CPU & GPU Thermal Telemetry -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Chamfered Header Tab -->
                            <Border Grid.Row="0" Background="{DynamicResource HeaderTabBackground}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0"
                                    HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                    CornerRadius="4,12,0,0">
                                <TextBlock Text="{DynamicResource S.Readings.HeaderCpuGpu}" Style="{DynamicResource PanelHeaderTextStyle}" />
                            </Border>

                            <!-- Panel Card -->
                            <Border Grid.Row="1" Style="{DynamicResource Card}" CornerRadius="0,6,6,6" Padding="14,12">
                                <StackPanel VerticalAlignment="Center">
                                    <!-- CPU Indicator & Bar -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource S.Readings.Cpu}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                                        </StackPanel>
                                        <TextBlock x:Name="CpuClock" Grid.Column="1" Style="{DynamicResource Label}"
                                                   Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                                   TextAlignment="Right" HorizontalAlignment="Right"
                                                   Margin="6,0,8,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CpuTemp" Grid.Column="2" Text="-- °C"
                                                   Style="{DynamicResource Label}"
                                                   Foreground="{DynamicResource Ink}" FontWeight="SemiBold" />
                                    </Grid>
                                    <c:SegmentedBar Value="{Binding Text, ElementName=CpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                    LitBrush="{DynamicResource Accent}"
                                                    UnlitBrush="{DynamicResource GaugeTrackBrush}"
                                                    Height="8" Margin="0,5,0,10" />

                                    <!-- GPU Indicator & Bar -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource S.Readings.Gpu}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                                        </StackPanel>
                                        <TextBlock x:Name="GpuClock" Grid.Column="1" Style="{DynamicResource Label}"
                                                   Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                                   TextAlignment="Right" HorizontalAlignment="Right"
                                                   Margin="6,0,8,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="GpuTemp" Grid.Column="2" Text="-- °C"
                                                   Style="{DynamicResource Label}"
                                                   Foreground="{DynamicResource Ink}" FontWeight="SemiBold" />
                                    </Grid>
                                    <c:SegmentedBar Value="{Binding Text, ElementName=GpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                    LitBrush="{DynamicResource Accent}"
                                                    UnlitBrush="{DynamicResource GaugeTrackBrush}"
                                                    Height="8" Margin="0,5,0,0" />

                                    <!-- Subtle Divider -->
                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,8" />

                                    <!-- Overheat Warning Master Toggle & Reset -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource S.Readings.OverheatAlert}" Style="{DynamicResource Label}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ToggleButton x:Name="OverheatWarningToggle" Style="{DynamicResource Pill}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{DynamicResource S.Readings.OverheatAlertTooltip}" />
                                        </StackPanel>
                                        <Button x:Name="OverheatResetButton" Grid.Column="1" Content="{DynamicResource S.Readings.Reset}"
                                                Style="{StaticResource WarnResetButtonStyle}"
                                                IsEnabled="{Binding IsChecked, ElementName=OverheatWarningToggle}"
                                                VerticalAlignment="Center"
                                                ToolTip="{DynamicResource S.Readings.ResetTooltip}" />
                                    </Grid>

                                    <!-- Dual Threshold Sliders (CPU & GPU) -->
                                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=OverheatWarningToggle}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- CPU Threshold Row -->
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource S.Readings.Cpu}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                            <Slider x:Name="CpuWarnSlider" Grid.Column="1" Minimum="60" Maximum="105"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox x:Name="CpuWarnValue" Grid.Column="2"
                                                     Style="{StaticResource WarnValueTextBoxStyle}" />
                                        </Grid>

                                        <!-- GPU Threshold Row -->
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource S.Readings.Gpu}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                            <Slider x:Name="GpuWarnSlider" Grid.Column="1" Minimum="60" Maximum="105"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox x:Name="GpuWarnValue" Grid.Column="2"
                                                     Style="{StaticResource WarnValueTextBoxStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Panel 2: Memory & Disk Conditions (Donut Gauges Card with Stacked RAM & SSD Rows) -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Chamfered Header Tab -->
                            <Border Grid.Row="0" Background="{DynamicResource HeaderTabBackground}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0"
                                    HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                    CornerRadius="4,12,0,0">
                                <TextBlock Text="{DynamicResource S.Readings.HeaderMemoryDisk}" Style="{DynamicResource PanelHeaderTextStyle}" />
                            </Border>

                            <!-- Donut Gauges Card with Stacked RAM & SSD Rows -->
                            <Border Grid.Row="1" Style="{DynamicResource Card}" CornerRadius="0,6,6,6" Padding="14,10">
                                <StackPanel>
                                    <!-- Row 1: RAM Condition -->
                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <c:DonutGauge x:Name="RamGauge" Grid.Column="0" Value="0" Maximum="100" Width="64" Height="64"
                                                      ArcBrush="#FFA000"
                                                      TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                      BracketBrush="{DynamicResource Line}"
                                                      HubBrush="{DynamicResource CardBackground}"
                                                      StrokeThickness="7" HorizontalAlignment="Left" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#FF7700" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{DynamicResource S.Readings.Ram}" Style="{DynamicResource Label}" Foreground="{DynamicResource Ink}"
                                                           FontWeight="Bold" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock x:Name="RamPercent" Text="--" Style="{DynamicResource Value}" FontSize="22"
                                                       Foreground="{DynamicResource Ink}" Margin="0,1,0,0" />
                                            <TextBlock x:Name="RamDetail" Text="--" Style="{DynamicResource Label}"
                                                       FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fixed Drives List (§18) -->
                                    <ItemsControl x:Name="DriveList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Row Divider above each drive row -->
                                                        <Border x:Name="DriveDivider" Height="1" Background="{DynamicResource Line}" Margin="0,4,0,8" />

                                                        <!-- Drive Gauge & Telemetry Row -->
                                                        <Grid x:Name="DriveRowGrid" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="ColGauge" Width="68" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <c:DonutGauge x:Name="DriveGauge" Grid.Column="0"
                                                                          Value="{Binding Percent}" Maximum="100"
                                                                          Width="64" Height="64"
                                                                          ArcBrush="#0088FF"
                                                                          TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                                          BracketBrush="{DynamicResource Line}"
                                                                          HubBrush="{DynamicResource CardBackground}"
                                                                          StrokeThickness="7" HorizontalAlignment="Left" />

                                                            <StackPanel x:Name="DriveTextStack" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse x:Name="DriveDot" Width="6" Height="6" Fill="#0088FF"
                                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Label}"
                                                                               Foreground="{DynamicResource Ink}"
                                                                               FontWeight="Bold" FontSize="11" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="DrivePercentText" Text="{Binding PercentText}"
                                                                           Style="{DynamicResource Value}" FontSize="22"
                                                                           Foreground="{DynamicResource Ink}" Margin="0,1,0,0" />
                                                                <TextBlock x:Name="DriveDetailText" Text="{Binding Detail}"
                                                                           Style="{DynamicResource Label}" FontSize="10.5"
                                                                           Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <!-- 2 Drives: scaled down together so both fit with nothing cramped -->
                                                        <DataTrigger Binding="{Binding Path=ItemsSource.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="2">
                                                            <Setter TargetName="DriveGauge" Property="Width" Value="42" />
                                                            <Setter TargetName="DriveGauge" Property="Height" Value="42" />
                                                            <Setter TargetName="DriveGauge" Property="StrokeThickness" Value="5" />
                                                            <Setter TargetName="ColGauge" Property="Width" Value="48" />
                                                            <Setter TargetName="DriveTextStack" Property="Margin" Value="8,0,0,0" />
                                                            <Setter TargetName="DriveDot" Property="Width" Value="5" />
                                                            <Setter TargetName="DriveDot" Property="Height" Value="5" />
                                                            <Setter TargetName="DrivePercentText" Property="FontSize" Value="15" />
                                                            <Setter TargetName="DriveDetailText" Property="FontSize" Value="9.5" />
                                                            <Setter TargetName="DriveDivider" Property="Margin" Value="0,2,0,3" />
                                                            <Setter TargetName="DriveRowGrid" Property="Margin" Value="0,0,0,2" />
                                                        </DataTrigger>
                                                        <!-- 3 Drives: scaled down further so 3 drives fit cleanly without growing panel -->
                                                        <DataTrigger Binding="{Binding Path=ItemsSource.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="3">
                                                            <Setter TargetName="DriveGauge" Property="Width" Value="28" />
                                                            <Setter TargetName="DriveGauge" Property="Height" Value="28" />
                                                            <Setter TargetName="DriveGauge" Property="StrokeThickness" Value="3.5" />
                                                            <Setter TargetName="ColGauge" Property="Width" Value="34" />
                                                            <Setter TargetName="DriveTextStack" Property="Margin" Value="6,0,0,0" />
                                                            <Setter TargetName="DriveDot" Property="Width" Value="4" />
                                                            <Setter TargetName="DriveDot" Property="Height" Value="4" />
                                                            <Setter TargetName="DrivePercentText" Property="FontSize" Value="12" />
                                                            <Setter TargetName="DriveDetailText" Property="FontSize" Value="8.5" />
                                                            <Setter TargetName="DriveDivider" Property="Margin" Value="0,1,0,2" />
                                                            <Setter TargetName="DriveRowGrid" Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                        <!-- 4 Drives fallback -->
                                                        <DataTrigger Binding="{Binding Path=ItemsSource.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="4">
                                                            <Setter TargetName="DriveGauge" Property="Width" Value="24" />
                                                            <Setter TargetName="DriveGauge" Property="Height" Value="24" />
                                                            <Setter TargetName="DriveGauge" Property="StrokeThickness" Value="3" />
                                                            <Setter TargetName="ColGauge" Property="Width" Value="28" />
                                                            <Setter TargetName="DriveTextStack" Property="Margin" Value="5,0,0,0" />
                                                            <Setter TargetName="DriveDot" Property="Width" Value="4" />
                                                            <Setter TargetName="DriveDot" Property="Height" Value="4" />
                                                            <Setter TargetName="DrivePercentText" Property="FontSize" Value="11" />
                                                            <Setter TargetName="DriveDetailText" Property="FontSize" Value="8" />
                                                            <Setter TargetName="DriveDivider" Property="Margin" Value="0,1,0,1" />
                                                            <Setter TargetName="DriveRowGrid" Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <!-- In-Window Modal Dialog Overlay -->
            <Grid x:Name="ModalDialogOverlay" Grid.RowSpan="2" Background="#99000000"
                  Visibility="Collapsed" Panel.ZIndex="1000">
                <Border Style="{DynamicResource Card}" MaxWidth="500" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Padding="24,20" CornerRadius="8"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="DialogTitleText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,10" />
                        <TextBlock x:Name="DialogBodyText" Style="{DynamicResource StatusTextStyle}"
                                   FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,20" />
                        <!-- Progress Bar (§17) -->
                        <ProgressBar x:Name="DialogProgress" Minimum="0" Maximum="100" Height="6"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource GaugeTrackBrush}"
                                     BorderThickness="0"
                                     Margin="0,0,0,20"
                                     Visibility="Collapsed" />
                        <StackPanel x:Name="DialogActions" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogButtonSecondary"
                                    Style="{DynamicResource DialogSecondaryButton}"
                                    Margin="0,0,10,0" Padding="16,6"
                                    Content="{DynamicResource S.Dialog.Cancel}" Visibility="Collapsed" />
                            <Button x:Name="DialogButtonPrimary"
                                    Style="{DynamicResource DialogPrimaryButton}"
                                    Padding="16,6"
                                    Content="{DynamicResource S.Dialog.OK}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Guided Tour Overlay (§20) -->
            <Grid x:Name="TourOverlay" Grid.RowSpan="2" Panel.ZIndex="900"
                  Background="Transparent" Visibility="Collapsed">
                <Path x:Name="TourShade" Fill="#99000000" />
                <Canvas x:Name="TourCanvas">
                    <Border x:Name="TourCard"
                            Style="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="TourTitle"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="TourBody"
                                       Style="{DynamicResource StatusTextStyle}"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <TextBlock x:Name="TourCounter"
                                       Style="{DynamicResource StatusTextStyle}"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="11"
                                       Margin="0,0,0,10" />
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="TourSkip"
                                            Content="{DynamicResource S.Tour.Skip}"
                                            Style="{StaticResource TourLinkButtonStyle}"
                                            Margin="0,0,6,0" />
                                    <Button x:Name="TourSkipSection"
                                            Style="{StaticResource TourLinkButtonStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="TourBack"
                                            Content="{DynamicResource S.Tour.Back}"
                                            Style="{StaticResource TourBackButtonStyle}"
                                            Margin="0,0,6,0" />
                                    <Button x:Name="TourNext"
                                            Content="{DynamicResource S.Tour.Next}"
                                            Style="{DynamicResource DialogPrimaryButton}"
                                            FontSize="11.5"
                                            Padding="12,4"
                                            MinWidth="56" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
