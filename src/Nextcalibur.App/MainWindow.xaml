                    <!-- ================= PAGE: DISPLAY ================= -->
                    <Grid x:Name="PageDisplay" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
