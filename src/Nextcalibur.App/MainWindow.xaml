                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Active by default when B and C are not checked -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.035" ScaleY="1.035" />
                                <TranslateTransform Y="-2.5" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <!-- Active when SelectAll is checked -->
                <DataTrigger Binding="{Binding IsChecked, ElementName=SelectAll}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.035" ScaleY="1.035" />
                                <TranslateTransform Y="-2.5" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- Hover preview when B is checked -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsChecked, ElementName=SelectAll}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Panel.ZIndex" Value="8" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.018" ScaleY="1.018" />
                                <TranslateTransform Y="-1" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.4" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <!-- Hover preview when C is checked -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsChecked, ElementName=SelectAll}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Panel.ZIndex" Value="8" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.018" ScaleY="1.018" />
                                <TranslateTransform Y="-1" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.4" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ZoneActiveOverlayStyleA" TargetType="Grid">
            <Setter Property="Opacity" Value="0.0" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="False" />
