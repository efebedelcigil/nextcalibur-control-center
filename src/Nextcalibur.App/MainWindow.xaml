<Window x:Class="Nextcalibur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nextcalibur.App.Controls"
        Title="Nextcalibur Control Center"
        Width="1024" Height="556"
        ResizeMode="NoResize" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:TemperatureToDoubleConverter x:Key="TemperatureToDoubleConverter" />
            <c:RpmToDoubleConverter x:Key="RpmToDoubleConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Window Border with Square Corners (0px) -->
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{StaticResource TitleBarBackground}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: LogoMark + Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="{StaticResource LogoMarkGeometry}" Fill="#FFFFFF"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="NEXTCALIBUR  CONTROL CENTER"
                               Style="{StaticResource WordmarkTextStyle}" />
                </StackPanel>

                <!-- Center/Right: Abstract Copper Circuit Header Artwork with Gradient Fade -->
                <Viewbox Grid.Column="2" Stretch="UniformToFill" Width="380" Height="36"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Viewbox.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                            <GradientStop Color="#FF000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Viewbox.OpacityMask>
                    <Image Source="{StaticResource HeaderCircuitImage}" Width="380" Height="36" />
                </Viewbox>

                <!-- Right: Caption Buttons (Minimise & Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimiseClick"
                            Tag="{StaticResource IconMinimise}" ToolTip="Minimise" />
                    <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"
                            Tag="{StaticResource IconClose}" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail -->
                <Border Grid.Column="0" Background="{StaticResource RailBackground}"
                        BorderBrush="{StaticResource RailBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Rail Wordmark -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,18">
                            <TextBlock Text="NEXT" Foreground="{StaticResource Accent}"
                                       FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="CALIBUR" Foreground="{StaticResource Ink}"
                                       FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>

                        <!-- Nav Rail Buttons -->
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="System"
                                         GroupName="Nav" IsChecked="True" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavSystem}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>

                            <RadioButton x:Name="NavPower" Style="{StaticResource NavItem}" Tag="Power"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavPower}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>

                            <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" Tag="Lighting"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavLighting}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area Container -->
                <Grid Grid.Column="1" Margin="18,14,18,16">

                    <!-- ================= PAGE: SYSTEM ================= -->
                    <Grid x:Name="PageSystem" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: System Status, Banner, and Center Fan Gauges -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Status Subtitle -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="System Sensors" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="SubtitleText" Style="{StaticResource StatusTextStyle}"
                                           Margin="0,3,0,0" Text="Reading sensors..." />
                            </StackPanel>

                            <!-- Warning Banner (starts Collapsed) -->
                            <Border x:Name="Banner" Grid.Row="1" Style="{StaticResource Card}"
                                    Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="{StaticResource Warn}">
                                <StackPanel>
                                    <TextBlock x:Name="BannerTitle" Foreground="{StaticResource Warn}"
                                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BannerBody" Style="{StaticResource StatusTextStyle}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Center Gauges Dashboard Area -->
                            <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Fan & Temp Unit -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <c:FanGauge x:Name="CpuFanGauge" Width="180" Height="180"
                                                    Value="{Binding Text, ElementName=CpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                    Maximum="6000"
                                                    ArcBrush="{StaticResource Accent}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0">
                                                <TextBlock x:Name="CpuFan" Text="-- rpm"
                                                           Style="{StaticResource Value}" FontSize="21"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="CPU FAN" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </c:FanGauge>

                                        <Border Background="{StaticResource PanelBackground}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="5" Padding="12,8" Margin="0,16,0,0" Width="180">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="CpuTemp" Text="-- °C"
                                                           Style="{StaticResource Value}" FontSize="24"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Subtle Vertical Divider -->
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"
                                            Height="240" HorizontalAlignment="Center" />

                                    <!-- GPU Fan & Temp Unit -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <c:FanGauge x:Name="GpuFanGauge" Width="180" Height="180"
                                                    Value="{Binding Text, ElementName=GpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                    Maximum="6000"
                                                    ArcBrush="{StaticResource Accent}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0">
                                                <TextBlock x:Name="GpuFan" Text="-- rpm"
                                                           Style="{StaticResource Value}" FontSize="21"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="GPU FAN" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </c:FanGauge>

                                        <Border Background="{StaticResource PanelBackground}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="5" Padding="12,8" Margin="0,16,0,0" Width="180">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="GpuTemp" Text="-- °C"
                                                           Style="{StaticResource Value}" FontSize="24"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Right Column: Chamfered Panels for CPU & GPU and Memory & Disk -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Panel 1: CPU & GPU -->
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Chamfered Header Tab -->
                                <Border Grid.Row="0" Background="{StaticResource HeaderTabBackground}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0"
                                        HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                        CornerRadius="4,12,0,0">
                                    <TextBlock Text="CPU &amp; GPU" Style="{StaticResource PanelHeaderTextStyle}" />
                                </Border>

                                <!-- Panel Content Card -->
                                <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="0,6,6,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- CPU Device Row -->
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" />
                                                <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text, ElementName=CpuTemp}"
                                                       Foreground="{Binding Foreground, ElementName=CpuTemp}"
                                                       FontWeight="Bold" FontSize="17" HorizontalAlignment="Right" />
                                        </Grid>
                                        <c:SegmentedBar Value="{Binding Text, ElementName=CpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                        Minimum="0" Maximum="100" SegmentCount="16" Height="10"
                                                        LitBrush="{Binding Foreground, ElementName=CpuTemp}" />

                                        <!-- GPU Device Row -->
                                        <Grid Margin="0,18,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" />
                                                <TextBlock Text="GPU" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text, ElementName=GpuTemp}"
                                                       Foreground="{Binding Foreground, ElementName=GpuTemp}"
                                                       FontWeight="Bold" FontSize="17" HorizontalAlignment="Right" />
                                        </Grid>
                                        <c:SegmentedBar Value="{Binding Text, ElementName=GpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                        Minimum="0" Maximum="100" SegmentCount="16" Height="10"
                                                        LitBrush="{Binding Foreground, ElementName=GpuTemp}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Panel 2: Memory & Disk -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Chamfered Header Tab -->
                                <Border Grid.Row="0" Background="{StaticResource HeaderTabBackground}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0"
                                        HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                        CornerRadius="4,12,0,0">
                                    <TextBlock Text="Memory &amp; Disk" Style="{StaticResource PanelHeaderTextStyle}" />
                                </Border>

                                <!-- Donut Gauges Card -->
                                <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="0,6,6,6">
                                    <UniformGrid Columns="2" VerticalAlignment="Center">
                                        <!-- RAM Donut -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <c:DonutGauge Value="42" Maximum="100" Width="82" Height="82"
                                                          ArcBrush="{StaticResource Accent}" StrokeThickness="7" />
                                            <TextBlock Text="RAM" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock Text="42%" Style="{StaticResource Value}" FontSize="15"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- SSD Donut -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <c:DonutGauge Value="68" Maximum="100" Width="82" Height="82"
                                                          ArcBrush="{StaticResource Accent}" StrokeThickness="7" />
                                            <TextBlock Text="SSD" Style="{StaticResource Label}"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock Text="68%" Style="{StaticResource Value}" FontSize="15"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE: POWER ================= -->
                    <Grid x:Name="PagePower" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Power Management" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,16" />

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid VerticalAlignment="Center" Margin="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACTIVE POWER OVERLAY" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="OverlayState" Foreground="{StaticResource Good}"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Text="Checking..." />
                                    <TextBlock x:Name="OverlayDetail" Style="{StaticResource StatusTextStyle}"
                                               Margin="0,10,32,0" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>

                                <Button x:Name="FixButton" Grid.Column="1" Content="Repair"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="OnRepairClick" Padding="18,8" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PAGE: LIGHTING ================= -->
                    <Grid x:Name="PageLighting" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="316" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Zone Tabs, Vector Keyboard Backlight Preview, Profile Row -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Zone Selection Tabs -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="TabZoneA" Style="{StaticResource ZoneTab}" Content="Zone A"
                                             GroupName="Zone" IsChecked="True" Checked="OnZoneTabChanged" Tag="Left" />
                                <RadioButton x:Name="TabZoneB" Style="{StaticResource ZoneTab}" Content="Zone B"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Middle" />
                                <RadioButton x:Name="TabZoneC" Style="{StaticResource ZoneTab}" Content="Zone C"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Right" />
                            </StackPanel>

                            <!-- Keyboard Vector Chassis & Backlight Zones Preview -->
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Laptop Keyboard Recessed Well -->
                                    <Border Background="#08090C" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1.5" CornerRadius="8" Padding="8">
                                        <Grid Height="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Zone A (Left) Backlight Surface -->
                                            <Border x:Name="PreviewA" Grid.Column="0" CornerRadius="6"
                                                    Margin="4" Background="#FFFFFF"
                                                    BorderBrush="{StaticResource Accent}" BorderThickness="2">
                                                <!-- Realistic Keycap Grid Overlay -->
                                                <UniformGrid Columns="4" Rows="5" Margin="6" Opacity="0.88">
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                </UniformGrid>
                                            </Border>

                                            <!-- Zone B (Middle) Backlight Surface -->
                                            <Border x:Name="PreviewB" Grid.Column="1" CornerRadius="6"
                                                    Margin="4" Background="#FFFFFF"
                                                    BorderBrush="Transparent" BorderThickness="2">
                                                <UniformGrid Columns="4" Rows="5" Margin="6" Opacity="0.88">
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                </UniformGrid>
                                            </Border>

                                            <!-- Zone C (Right) Backlight Surface -->
                                            <Border x:Name="PreviewC" Grid.Column="2" CornerRadius="6"
                                                    Margin="4" Background="#FFFFFF"
                                                    BorderBrush="Transparent" BorderThickness="2">
                                                <UniformGrid Columns="4" Rows="5" Margin="6" Opacity="0.88">
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                    <Border Background="#14161C" CornerRadius="3" Margin="2" />
                                                </UniformGrid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Profile Presets Dock -->
                            <StackPanel x:Name="ProfileRow" Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,12,0,0">
                                <RadioButton x:Name="ProfOffice" Style="{StaticResource ProfileButton}" Content="Office"
                                             GroupName="Profile" Checked="OnProfileChecked" Tag="Office" />
                                <RadioButton x:Name="ProfGaming" Style="{StaticResource ProfileButton}" Content="Gaming"
                                             GroupName="Profile" Checked="OnProfileChecked" Tag="Gaming" />
                                <RadioButton x:Name="ProfPerformance" Style="{StaticResource ProfileButton}" Content="Performance"
                                             GroupName="Profile" Checked="OnProfileChecked" Tag="Performance" />
                                <RadioButton x:Name="ProfUser" Style="{StaticResource ProfileButton}" Content="User Define"
                                             GroupName="Profile" IsChecked="True" Checked="OnProfileChecked" Tag="UserDefine" />
                            </StackPanel>
                        </Grid>

                        <!-- Right: Lighting Controls Panel -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource PanelBackground}">
                            <StackPanel>
                                <!-- Switches & Reload Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LED On/Off Toggle -->
                                    <StackPanel Grid.Column="0">
                                        <ToggleButton x:Name="LedPower" Style="{StaticResource Pill}" IsChecked="True"
                                                      HorizontalAlignment="Left" Click="OnLedPowerToggled" />
                                        <TextBlock Text="LED on/off" Style="{StaticResource Label}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <!-- Select All Toggle -->
                                    <StackPanel Grid.Column="1">
                                        <ToggleButton x:Name="SelectAll" Style="{StaticResource Pill}"
                                                      HorizontalAlignment="Left" Click="OnSelectAllToggled" />
                                        <TextBlock Text="Select all" Style="{StaticResource Label}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <!-- Reload Button -->
                                    <Button x:Name="ReloadButton" Grid.Column="2" Content="Reload"
                                            Click="OnReloadClick" VerticalAlignment="Top" />
                                </Grid>

                                <!-- Subtle Separator -->
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,10" />

                                <!-- Lighting Effects Grid -->
                                <UniformGrid x:Name="EffectPanel" Columns="3" HorizontalAlignment="Center">
                                    <RadioButton x:Name="FxStatic" Style="{StaticResource EffectButton}" Content="Static"
                                                 GroupName="Fx" IsChecked="True" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxStatic}" />
                                    <RadioButton x:Name="FxBreathing" Style="{StaticResource EffectButton}" Content="Breathing"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxBreathing}" />
                                    <RadioButton x:Name="FxBlink" Style="{StaticResource EffectButton}" Content="Blink"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxBlink}" />
                                    <RadioButton x:Name="FxHeartbeat" Style="{StaticResource EffectButton}" Content="Heartbeat"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxHeartbeat}" />
                                    <RadioButton x:Name="FxCycle" Style="{StaticResource EffectButton}" Content="Colour cycle"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxCycle}" />
                                    <RadioButton x:Name="FxWave" Style="{StaticResource EffectButton}" Content="Wave"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{StaticResource IconFxWave}" />
                                </UniformGrid>

                                <!-- Hardware Colour Wheel -->
                                <c:ColourWheel x:Name="Wheel" Width="170" Height="170" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" ColourPicked="OnColourPicked" />

                                <!-- Colour Wheel Hint Text (starts Collapsed) -->
                                <TextBlock x:Name="WheelHint" Style="{StaticResource Label}" Margin="0,4,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="This effect drives its own colours in firmware, so the wheel does not apply." />

                                <!-- Brightness Controls -->
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Brightness" Style="{StaticResource Label}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BrightnessValue" Text="100%"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100"
                                        TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="None"
                                        Margin="0,3,0,0" ValueChanged="OnBrightnessChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
