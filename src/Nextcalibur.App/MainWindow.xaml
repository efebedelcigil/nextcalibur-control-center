                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="154" /> <!-- Zone A (Left) -->
                                                        <ColumnDefinition Width="138" /> <!-- Zone B (Middle) -->
                                                        <ColumnDefinition Width="196" /> <!-- Zone C (Right + Numpad) -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ================= ZONE A: LEFT KEYBOARD ================= -->
                                                    <Border x:Name="PreviewA" Grid.Column="0" CornerRadius="3"
                                                            Margin="1" Background="#FFFFFF"
                                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                                        <Grid Margin="2">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewA}"
                                                                    Opacity="0.20" CornerRadius="2" />

                                                            <!-- Keycaps take backlight colour via Binding to PreviewA.Background -->
                                                            <Grid Margin="1">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="16" /> <!-- Fn row -->
                                                                    <RowDefinition Height="24" /> <!-- Num row -->
                                                                    <RowDefinition Height="24" /> <!-- QWERTY -->
                                                                    <RowDefinition Height="24" /> <!-- Home -->
                                                                    <RowDefinition Height="24" /> <!-- ZXCV -->
                                                                    <RowDefinition Height="26" /> <!-- Modifiers -->
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: Esc, F1-F5 -->
                                                                <UniformGrid Grid.Row="0" Columns="6" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 1: ~, 1-5 -->
                                                                <UniformGrid Grid.Row="1" Columns="6" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 2: Tab (wide), Q, W (gamer key), E, R, T -->
                                                                <Grid Grid.Row="2" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.5*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="1" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <!-- W (WASD Gamer Key highlight) -->
                                                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1.5" CornerRadius="2" Margin="1">
                                                                        <Border BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" Margin="2" CornerRadius="1" />
                                                                    </Border>
                                                                    <Border Grid.Column="3" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="4" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="5" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </Grid>

                                                                <!-- Row 3: Caps (wide), A, S, D (gamer keys), F, G -->
                                                                <Grid Grid.Row="3" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.7*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <!-- A (WASD Gamer Key highlight) -->
                                                                    <Border Grid.Column="1" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1.5" CornerRadius="2" Margin="1">
                                                                        <Border BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" Margin="2" CornerRadius="1" />
                                                                    </Border>
                                                                    <!-- S (WASD Gamer Key highlight) -->
                                                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1.5" CornerRadius="2" Margin="1">
                                                                        <Border BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" Margin="2" CornerRadius="1" />
                                                                    </Border>
                                                                    <!-- D (WASD Gamer Key highlight) -->
                                                                    <Border Grid.Column="3" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1.5" CornerRadius="2" Margin="1">
                                                                        <Border BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" Margin="2" CornerRadius="1" />
                                                                    </Border>
                                                                    <Border Grid.Column="4" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="5" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </Grid>

                                                                <!-- Row 4: L-Shift (extra wide), Z, X, C, V, B -->
                                                                <Grid Grid.Row="4" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.1*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="1" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="3" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="4" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="5" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </Grid>

                                                                <!-- Row 5: L-Ctrl, Fn, Win, Alt, Space (left half) -->
                                                                <Grid Grid.Row="5" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="1.1*" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="1" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="3" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="4" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewA}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ================= ZONE B: MIDDLE KEYBOARD ================= -->
                                                    <Border x:Name="PreviewB" Grid.Column="1" CornerRadius="3"
                                                            Margin="1" Background="#FFFFFF"
                                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                                        <Grid Margin="2">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewB}"
                                                                    Opacity="0.20" CornerRadius="2" />

                                                            <!-- Keycaps take backlight colour via Binding to PreviewB.Background -->
                                                            <Grid Margin="1">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="16" /> <!-- Fn row -->
                                                                    <RowDefinition Height="24" /> <!-- Num row -->
                                                                    <RowDefinition Height="24" /> <!-- QWERTY -->
                                                                    <RowDefinition Height="24" /> <!-- Home -->
                                                                    <RowDefinition Height="24" /> <!-- ZXCV -->
                                                                    <RowDefinition Height="26" /> <!-- Modifiers -->
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: F6-F10 -->
                                                                <UniformGrid Grid.Row="0" Columns="5" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 1: 6, 7, 8, 9, 0 -->
                                                                <UniformGrid Grid.Row="1" Columns="5" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 2: Y, U, I, O, P -->
                                                                <UniformGrid Grid.Row="2" Columns="5" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 3: H, J, K, L, ; -->
                                                                <UniformGrid Grid.Row="3" Columns="5" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 4: N, M, ,, ., / -->
                                                                <UniformGrid Grid.Row="4" Columns="5" Margin="0,1">
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </UniformGrid>

                                                                <!-- Row 5: Space (right half), AltGr, Fn, Ctrl -->
                                                                <Grid Grid.Row="5" Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.5*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="1" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="2" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                    <Border Grid.Column="3" Background="#161822" BorderBrush="{Binding Background, ElementName=PreviewB}" BorderThickness="1" CornerRadius="2" Margin="1" />
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ================= ZONE C: RIGHT KEYBOARD + NUMPAD ================= -->
                                                    <Border x:Name="PreviewC" Grid.Column="2" CornerRadius="3"
                                                            Margin="1" Background="#FFFFFF"
                                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                                        <Grid Margin="2">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewC}"
                                                                    Opacity="0.20" CornerRadius="2" />

