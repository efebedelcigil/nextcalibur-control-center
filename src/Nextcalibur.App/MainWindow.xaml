        <!-- Keyboard Zone Elevation & Lighting Styles (Zero-Shader, Vector-Preserved, Whole Keycaps) -->
        <Style x:Key="ZoneStyleA" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.40" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.177,0.486" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Continuous Hit Region behind keys: covers keys and inter-key gaps without overlap -->
                            <Path Data="{StaticResource KeyboardHitRegionLeft}"
                                  Fill="Transparent" />
                            <Path x:Name="Keycaps"
                                  Data="{StaticResource KeyboardGeometryLeft}"
                                  Stroke="{Binding Background, ElementName=PreviewA}"
                                  StrokeThickness="1.0"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="False" />
                                    <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Keycaps" Property="StrokeThickness" Value="1.4" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SelectAll}" Value="True">
                                <Setter TargetName="Keycaps" Property="StrokeThickness" Value="1.4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selected state retains lift from explicit user action -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
                                <TranslateTransform Y="-2" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SelectAll}" Value="True">
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                <TranslateTransform Y="-2" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- Hover triggers modify visual opacity only; strictly NO RenderTransform movement or ZIndex juggling -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsChecked, ElementName=SelectAll}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneB}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.70" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsChecked, ElementName=SelectAll}" Value="False" />
                        <Condition Binding="{Binding IsChecked, ElementName=TabZoneC}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.70" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

