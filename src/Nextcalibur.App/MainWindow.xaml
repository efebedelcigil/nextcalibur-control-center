<Window x:Class="Nextcalibur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nextcalibur.App.Controls"
        Title="Nextcalibur Control Center"
        Height="670" Width="1050" MinHeight="620" MinWidth="980"
        Background="#0E1016"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink"    Color="#E8EAF0" />
        <SolidColorBrush x:Key="Muted"  Color="#7C8394" />
        <SolidColorBrush x:Key="Panel"  Color="#171A23" />
        <SolidColorBrush x:Key="Rail"   Color="#12141B" />
        <SolidColorBrush x:Key="Line"   Color="#272C38" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <SolidColorBrush x:Key="Good"   Color="#3FBF7F" />
        <SolidColorBrush x:Key="Warn"   Color="#E8A33D" />
        <SolidColorBrush x:Key="Bad"    Color="#E5484D" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" Padding="0,18">
                            <StackPanel HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="11.5" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1B1F2A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#191D27" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoneTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#1B1F2A" CornerRadius="6" Padding="22,8"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#243049" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffectButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="4,8" Width="72">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Width="26" Height="22"
                                      Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="10.5" FontFamily="Segoe UI" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#243049" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1E2331" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#151821" CornerRadius="8" Padding="18,10" Margin="6,0"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="12" FontFamily="Segoe UI" TextAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#243049" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#2A3040" CornerRadius="11" Width="56" Height="22">
                            <Grid>
                                <TextBlock x:Name="Text" Text="off" Foreground="{StaticResource Muted}"
                                           FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,9,0" />
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Text" Property="Text" Value="on" />
                                <Setter TargetName="Text" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="Text" Property="Margin" Value="9,0,0,0" />
                                <Setter TargetName="Text" Property="Foreground" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="NEXT" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock Text="CALIBUR" Foreground="{StaticResource Ink}" FontSize="11"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="System"
                             GroupName="Nav" IsChecked="True" Checked="OnNavChanged">
                    <Path Data="M3,17 L7,9 L11,13 L15,4 L19,11" Stretch="Uniform" Width="26" Height="20"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                </RadioButton>

                <RadioButton x:Name="NavPower" Style="{StaticResource NavItem}" Tag="Power"
                             GroupName="Nav" Checked="OnNavChanged">
                    <Path Data="M12,2 L6,12 H11 L10,20 L17,9 H12 Z" Stretch="Uniform" Width="26" Height="20"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" />
                </RadioButton>

                <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" Tag="Lighting"
                             GroupName="Nav" Checked="OnNavChanged">
                    <Path Data="M12,3 A6,6 0 0,1 15,14 V17 H9 V14 A6,6 0 0,1 12,3 Z M9,20 H15"
                          Stretch="Uniform" Width="26" Height="20"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" />
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">

            <!-- ===== SYSTEM ===== -->
            <Grid x:Name="PageSystem">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="System" FontSize="19" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" Margin="0,4,0,0"
                               Text="Reading sensors..." />
                </StackPanel>

                <Border x:Name="Banner" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="Collapsed" BorderBrush="{StaticResource Warn}">
                    <StackPanel>
                        <TextBlock x:Name="BannerTitle" Foreground="{StaticResource Warn}" FontSize="13"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" TextWrapping="Wrap" />
                        <TextBlock x:Name="BannerBody" Style="{StaticResource Label}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Label}" />
                            <TextBlock x:Name="CpuTemp" Style="{StaticResource Value}" Text="--" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="CPU FAN" Style="{StaticResource Label}" />
                            <TextBlock x:Name="CpuFan" Style="{StaticResource Value}" Text="--" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Label}" />
                            <TextBlock x:Name="GpuTemp" Style="{StaticResource Value}" Text="--" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="GPU FAN" Style="{StaticResource Label}" />
                            <TextBlock x:Name="GpuFan" Style="{StaticResource Value}" Text="--" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ===== POWER ===== -->
            <Grid x:Name="PagePower" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Power" FontSize="19" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="{StaticResource Ink}" Margin="0,0,0,16" />

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="POWER MODE" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OverlayState" Foreground="{StaticResource Ink}" FontSize="16"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,6,0,0" Text="Checking..." />
                            <TextBlock x:Name="OverlayDetail" Style="{StaticResource Label}" Margin="0,8,20,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="FixButton" Grid.Column="1" Content="Repair" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="OnRepairClick" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== LIGHTING ===== -->
            <Grid x:Name="PageLighting" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="336" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="TabZoneA" Style="{StaticResource ZoneTab}" Content="Zone A"
                                 GroupName="Zone" IsChecked="True" Checked="OnZoneTabChanged" Tag="Left" />
                    <RadioButton x:Name="TabZoneB" Style="{StaticResource ZoneTab}" Content="Zone B"
                                 GroupName="Zone" Checked="OnZoneTabChanged" Tag="Middle" />
                    <RadioButton x:Name="TabZoneC" Style="{StaticResource ZoneTab}" Content="Zone C"
                                 GroupName="Zone" Checked="OnZoneTabChanged" Tag="Right" />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                    <Viewbox Stretch="Uniform" MaxHeight="300">
                        <Grid Width="500" Height="250">
                            <Border Background="#0A0C11" CornerRadius="12" />
                            <UniformGrid x:Name="PreviewGrid" Columns="3" Margin="20">
                                <Border x:Name="PreviewA" CornerRadius="8" Margin="5" Background="#FFFFFF"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="3">
                                    <TextBlock Text="A" FontSize="40" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="#2E000000" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="PreviewB" CornerRadius="8" Margin="5" Background="#FFFFFF"
                                        BorderBrush="Transparent" BorderThickness="3">
                                    <TextBlock Text="B" FontSize="40" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="#2E000000" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="PreviewC" CornerRadius="8" Margin="5" Background="#FFFFFF"
                                        BorderBrush="Transparent" BorderThickness="3">
                                    <TextBlock Text="C" FontSize="40" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="#2E000000" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel x:Name="ProfileRow" Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                            Margin="0,14,16,0" HorizontalAlignment="Center">
                    <RadioButton x:Name="ProfOffice" Style="{StaticResource ProfileButton}" Content="Office"
                                 GroupName="Profile" Checked="OnProfileChecked" Tag="Office" />
                    <RadioButton x:Name="ProfGaming" Style="{StaticResource ProfileButton}" Content="Gaming"
                                 GroupName="Profile" Checked="OnProfileChecked" Tag="Gaming" />
                    <RadioButton x:Name="ProfPerformance" Style="{StaticResource ProfileButton}" Content="Performance"
                                 GroupName="Profile" Checked="OnProfileChecked" Tag="Performance" />
                    <RadioButton x:Name="ProfUser" Style="{StaticResource ProfileButton}" Content="User Define"
                                 GroupName="Profile" IsChecked="True" Checked="OnProfileChecked" Tag="UserDefine" />
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ToggleButton x:Name="LedPower" Style="{StaticResource Pill}" IsChecked="True"
                                              HorizontalAlignment="Left" Click="OnLedPowerToggled" />
                                <TextBlock Text="LED on/off" Style="{StaticResource Label}" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ToggleButton x:Name="SelectAll" Style="{StaticResource Pill}"
                                              HorizontalAlignment="Left" Click="OnSelectAllToggled" />
                                <TextBlock Text="Select all" Style="{StaticResource Label}" Margin="0,7,0,0" />
                            </StackPanel>
                            <Button x:Name="ReloadButton" Grid.Column="2" Content="Reload" Click="OnReloadClick"
                                    Background="#2A3040" Padding="12,5" VerticalAlignment="Top" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

                        <WrapPanel x:Name="EffectPanel" HorizontalAlignment="Center">
                            <RadioButton x:Name="FxStatic" Style="{StaticResource EffectButton}" Content="Static"
                                         GroupName="Fx" IsChecked="True" Checked="OnEffectChecked"
                                         Tag="M4,12 A8,8 0 1,1 20,12 A8,8 0 1,1 4,12 Z" />
                            <RadioButton x:Name="FxBreathing" Style="{StaticResource EffectButton}" Content="Breathing"
                                         GroupName="Fx" Checked="OnEffectChecked"
                                         Tag="M2,12 C6,2 10,2 12,12 C14,22 18,22 22,12" />
                            <RadioButton x:Name="FxBlink" Style="{StaticResource EffectButton}" Content="Blink"
                                         GroupName="Fx" Checked="OnEffectChecked"
                                         Tag="M2,18 H7 V6 H13 V18 H18 V6 H22" />
                            <RadioButton x:Name="FxHeartbeat" Style="{StaticResource EffectButton}" Content="Heartbeat"
                                         GroupName="Fx" Checked="OnEffectChecked"
                                         Tag="M2,14 H6 L9,5 L13,20 L16,14 H22" />
                            <RadioButton x:Name="FxCycle" Style="{StaticResource EffectButton}" Content="Colour cycle"
                                         GroupName="Fx" Checked="OnEffectChecked"
                                         Tag="M20,12 A8,8 0 1,1 12,4 M12,1 L12,7 M17,7 L23,7" />
                            <RadioButton x:Name="FxWave" Style="{StaticResource EffectButton}" Content="Wave"
                                         GroupName="Fx" Checked="OnEffectChecked"
                                         Tag="M2,8 C6,3 8,13 12,8 C16,3 18,13 22,8 M2,16 C6,11 8,21 12,16 C16,11 18,21 22,16" />
                        </WrapPanel>

                        <c:ColourWheel x:Name="Wheel" Width="222" Height="222" Margin="0,16,0,0"
                                       HorizontalAlignment="Center" ColourPicked="OnColourPicked" />

                        <TextBlock x:Name="WheelHint" Style="{StaticResource Label}" Margin="0,8,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="This effect drives its own colours in firmware, so the wheel does not apply." />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Brightness" Style="{StaticResource Label}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrightnessValue" Text="100%" Foreground="{StaticResource Ink}"
                                       FontSize="19" FontFamily="Segoe UI" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Margin="0,6,0,0" ValueChanged="OnBrightnessChanged" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
