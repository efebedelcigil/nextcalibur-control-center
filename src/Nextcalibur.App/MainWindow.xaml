    </Window.Resources>

    <!-- Outer Window Border with Square Corners (0px) -->
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{DynamicResource TitleBarBackground}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: New Nextcalibur LogoMark Image + Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/logo.png" Width="41" Height="30" Stretch="Uniform"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="NEXTCALIBUR  CONTROL CENTER"
                               Style="{DynamicResource WordmarkTextStyle}" />
                </StackPanel>

                <!-- Center/Right: Abstract Copper Circuit Header Artwork with Gradient Fade -->
                <Viewbox Grid.Column="2" Stretch="UniformToFill" Width="360" Height="36"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Viewbox.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                            <GradientStop Color="#FF000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Viewbox.OpacityMask>
                    <Image Source="{DynamicResource HeaderCircuitImage}" Width="380" Height="36" />
                </Viewbox>

                <!-- Three-way Theme Setting: Dark / Light / Follow-System -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="4" Padding="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeDark" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="Dark" Checked="OnThemeChanged" ToolTip="Dark theme">
                            <Path Data="{DynamicResource IconThemeDark}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeLight" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="Light" Checked="OnThemeChanged" ToolTip="Light theme">
                            <Path Data="{DynamicResource IconThemeLight}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeSystem" Style="{DynamicResource ThemeToggleButtonStyle}"
                                     GroupName="Theme" Tag="System" Checked="OnThemeChanged" ToolTip="Follow Windows theme">
                            <Path Data="{DynamicResource IconThemeSystem}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right: Caption Buttons (Minimise & Close) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{DynamicResource CaptionButton}" Click="OnMinimiseClick"
                            Tag="{DynamicResource IconMinimise}" ToolTip="Minimise" />
                    <Button Style="{DynamicResource CloseButton}" Click="OnCloseClick"
                            Tag="{DynamicResource IconClose}" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail (4 items: System, Power Mode, Display, Lighting) -->
                <Border Grid.Column="0" Background="{DynamicResource RailBackground}"
                        BorderBrush="{DynamicResource RailBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Rail Wordmark -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,14,0,14">
                            <TextBlock Text="NEXT" Foreground="{DynamicResource Accent}"
                                       FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="CALIBUR" Foreground="{DynamicResource Ink}"
                                       FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Navigation Items Stack -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <!-- 1. System Dashboard -->
                            <RadioButton x:Name="NavSystem" Style="{DynamicResource NavItem}" Tag="System"
                                         GroupName="Nav" IsChecked="True" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavSystem}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 2. Power Mode -->
                            <RadioButton x:Name="NavPower" Style="{DynamicResource NavItem}" Tag="Power Mode"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavPower}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 3. Display Mode -->
                            <RadioButton x:Name="NavDisplay" Style="{DynamicResource NavItem}" Tag="Display"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavDisplay}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>

                            <!-- Subtle Divider -->
                            <Border Height="1" Background="{DynamicResource Line}" Margin="15,0" />

                            <!-- 4. LED / Lighting Control -->
                            <RadioButton x:Name="NavLighting" Style="{DynamicResource NavItem}" Tag="Lighting"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{DynamicResource IconNavLighting}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content Area -->
                <Grid Grid.Column="1" Margin="16,14,16,14">

                    <!-- ================= PAGE: SYSTEM ================= -->
                    <Grid x:Name="PageSystem" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Top System Mode Tabs -->
                            <RowDefinition Height="*" />    <!-- Main Content & Right Telemetry Panels -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: System Mode Tabs (Office, Gaming, Performance) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- 1. Office Mode -->
                            <RadioButton x:Name="ModeOffice" Style="{DynamicResource SystemModeTab}"
                                         Tag="Office" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconModeOffice}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Office" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Gaming Mode -->
                            <RadioButton x:Name="ModeGaming" Style="{DynamicResource SystemModeTab}"
                                         Tag="Gaming" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconModeGaming}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Gaming" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. High Performance Mode -->
                            <RadioButton x:Name="ModePerformance" Style="{DynamicResource SystemModeTab}"
                                         Tag="Performance" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconModePerformance}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Performance" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Row 1: Left Center Fan Gauges + Right Stats Panels -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <!-- Left/Center: Dual Fan Gauges, Temperatures & Status Subtitle -->
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Status Subtitle -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Hardware Monitoring" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}" />
                                    <TextBlock x:Name="SubtitleText" Style="{DynamicResource StatusTextStyle}"
                                               Text="Real-time thermal and cooling telemetry" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Overheat / Warning Banner -->
                                <Border x:Name="Banner" Grid.Row="1" Style="{DynamicResource Card}"
                                        Margin="0,0,0,10" Visibility="Collapsed" BorderBrush="{DynamicResource Warn}">
                                    <StackPanel>
                                        <TextBlock x:Name="BannerTitle" Foreground="{DynamicResource Warn}"
                                                   FontWeight="Bold" FontSize="13" />
                                        <TextBlock x:Name="BannerBody" Style="{DynamicResource StatusTextStyle}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Fan Speed Gauges Card -->
                                <Border Grid.Row="2" Style="{DynamicResource Card}" VerticalAlignment="Stretch">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU Fan & Temp Column -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <c:FanGauge x:Name="CpuFanGauge" Width="146" Height="146"
                                                        Value="{Binding Text, ElementName=CpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                        BladeBrush="{DynamicResource Accent}"
                                                        ArcBrush="{DynamicResource Accent}"
                                                        TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                        HubBrush="{DynamicResource PanelBackground}"
                                                        HubBorderBrush="{DynamicResource Line}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CpuFan" Text="0 rpm"
                                                               Style="{DynamicResource Value}" FontSize="17"
                                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="CPU FAN" Style="{DynamicResource Label}" FontSize="10"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </c:FanGauge>

                                            <Border Background="{DynamicResource PanelBackground}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    CornerRadius="4" Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="150">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="CPU TEMPERATURE" Style="{DynamicResource Label}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="CpuTemp" Text="-- °C"
                                                               Style="{DynamicResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock x:Name="CpuName" Style="{DynamicResource Label}"
                                                               Foreground="{DynamicResource Muted}" FontSize="10.5"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Vertical Divider -->
                                        <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" Margin="10,20" />

                                        <!-- GPU Fan & Temp Column -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <c:FanGauge x:Name="GpuFanGauge" Width="146" Height="146"
                                                        Value="{Binding Text, ElementName=GpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                        BladeBrush="{DynamicResource Accent}"
                                                        ArcBrush="{DynamicResource Accent}"
                                                        TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                        HubBrush="{DynamicResource PanelBackground}"
                                                        HubBorderBrush="{DynamicResource Line}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="GpuFan" Text="0 rpm"
                                                               Style="{DynamicResource Value}" FontSize="17"
                                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="GPU FAN" Style="{DynamicResource Label}" FontSize="10"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </c:FanGauge>

                                            <Border Background="{DynamicResource PanelBackground}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                    CornerRadius="4" Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="150">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="GPU TEMPERATURE" Style="{DynamicResource Label}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="GpuTemp" Text="-- °C"
                                                               Style="{DynamicResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock x:Name="GpuName" Style="{DynamicResource Label}"
                                                               Foreground="{DynamicResource Muted}" FontSize="10.5"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Right Column: CPU & GPU Segmented Telemetry + Memory & Disk Conditions -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Panel 1: CPU & GPU Thermal Telemetry -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Chamfered Header Tab -->
                                    <Border Grid.Row="0" Background="{DynamicResource HeaderTabBackground}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0"
                                            HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                            CornerRadius="4,12,0,0">
                                        <TextBlock Text="CPU &amp; GPU" Style="{DynamicResource PanelHeaderTextStyle}" />
                                    </Border>

                                    <!-- Panel Card -->
                                    <Border Grid.Row="1" Style="{DynamicResource Card}" CornerRadius="0,6,6,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <!-- CPU Indicator & Bar -->
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" Margin="0,0,8,0" />
                                                    <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text, ElementName=CpuTemp}"
                                                           HorizontalAlignment="Right" Style="{DynamicResource Label}"
                                                           Foreground="{DynamicResource Ink}" FontWeight="SemiBold" />
                                            </Grid>
                                            <c:SegmentedBar Value="{Binding Text, ElementName=CpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                            LitBrush="{DynamicResource Accent}"
                                                            UnlitBrush="{DynamicResource GaugeTrackBrush}"
                                                            Height="8" Margin="0,6,0,14" />

                                            <!-- GPU Indicator & Bar -->
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" Margin="0,0,8,0" />
                                                    <TextBlock Text="GPU" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text, ElementName=GpuTemp}"
                                                           HorizontalAlignment="Right" Style="{DynamicResource Label}"
                                                           Foreground="{DynamicResource Ink}" FontWeight="SemiBold" />
                                            </Grid>
                                            <c:SegmentedBar Value="{Binding Text, ElementName=GpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                            LitBrush="{DynamicResource Accent}"
                                                            UnlitBrush="{DynamicResource GaugeTrackBrush}"
                                                            Height="8" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Panel 2: Memory & Disk Conditions (Matching Reference Images with Stacked Donut Rows) -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Chamfered Header Tab -->
                                    <Border Grid.Row="0" Background="{DynamicResource HeaderTabBackground}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0"
                                            HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                            CornerRadius="4,12,0,0">
                                        <TextBlock Text="Memory &amp; Disk" Style="{DynamicResource PanelHeaderTextStyle}" />
                                    </Border>

                                    <!-- Donut Gauges Card with Stacked RAM & SSD Rows -->
                                    <Border Grid.Row="1" Style="{DynamicResource Card}" CornerRadius="0,6,6,6" Padding="14,10">
                                        <StackPanel>
                                            <!-- Row 1: RAM Condition (Yellow-Amber Arc, Bullet, Percentage, Capacity) -->
                                            <Grid Margin="0,2,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Donut Gauge with Yellow-Amber Arc -->
                                                <c:DonutGauge x:Name="RamGauge" Grid.Column="0" Value="46.8" Maximum="100" Width="64" Height="64"
                                                              ArcBrush="#FFA000"
                                                              TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                              BracketBrush="{DynamicResource Line}"
                                                              HubBrush="{DynamicResource CardBackground}"
                                                              StrokeThickness="7" HorizontalAlignment="Left" />

                                                <!-- Right: Metric Bullet, Percentage & Secondary Capacity -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#FF7700" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="RAM" Style="{DynamicResource Label}" Foreground="{DynamicResource Ink}"
                                                                   FontWeight="Bold" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="RamPercent" Text="46,8%" Style="{DynamicResource Value}" FontSize="22"
                                                               Foreground="{DynamicResource Ink}" Margin="0,1,0,0" />
                                                    <TextBlock x:Name="RamDetail" Text="14,9/31,7GB" Style="{DynamicResource Label}"
                                                               FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Subtle Row Divider -->
                                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,8" />

                                            <!-- Row 2: SSD Condition (Cyan-Blue Arc, Bullet, Percentage, Capacity) -->
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Donut Gauge with Cyan-Blue Arc -->
                                                <c:DonutGauge x:Name="SsdGauge" Grid.Column="0" Value="52.5" Maximum="100" Width="64" Height="64"
                                                              ArcBrush="#0088FF"
                                                              TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                              BracketBrush="{DynamicResource Line}"
                                                              HubBrush="{DynamicResource CardBackground}"
                                                              StrokeThickness="7" HorizontalAlignment="Left" />

                                                <!-- Right: Metric Bullet, Percentage & Secondary Capacity -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#0088FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="SSD" Style="{DynamicResource Label}" Foreground="{DynamicResource Ink}"
                                                                   FontWeight="Bold" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SsdPercent" Text="52,5%" Style="{DynamicResource Value}" FontSize="22"
                                                               Foreground="{DynamicResource Ink}" Margin="0,1,0,0" />
                                                    <TextBlock x:Name="SsdDetail" Text="733,0/1396,0G" Style="{DynamicResource Label}"
                                                               FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE: POWER ================= -->
                    <Grid x:Name="PagePower" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Header -->
                            <RowDefinition Height="Auto" /> <!-- 4 Power Mode Option Cards -->
                            <RowDefinition Height="*" />    <!-- Status and Repair Bar -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Power Mode" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,16" />

                        <!-- Four Windows Power Overlay Cards in a Row (None checked by default) -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Best Power Efficiency -->
                            <RadioButton x:Name="PowerModeEfficiency" Grid.Column="0"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Efficiency" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerSaver}" Width="52" Height="52" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Power Saver" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="PowerModeEfficiencyText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Balanced -->
                            <RadioButton x:Name="PowerModeBalanced" Grid.Column="1"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Balanced" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="3,0,3,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerBalanced}" Width="52" Height="52" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Balanced" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="PowerModeBalancedText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Better Performance -->
                            <RadioButton x:Name="PowerModeBetter" Grid.Column="2"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Better" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="3,0,3,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerPerformance}" Width="52" Height="52" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="High Performance" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="PowerModeBetterText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Best Performance -->
                            <RadioButton x:Name="PowerModeBest" Grid.Column="3"
                                         Style="{DynamicResource PowerModeCard}"
                                         Tag="Best" GroupName="PowerMode" Checked="OnPowerModeChanged"
                                         Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconPowerBest}" Width="52" Height="52" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Ultimate" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="PowerModeBestText"
                                               Style="{DynamicResource StatusTextStyle}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- Diagnosis and Repair Strip -->
                        <Border Grid.Row="2" Style="{DynamicResource Card}">
                            <Grid VerticalAlignment="Center" Margin="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CURRENT MODE" Style="{DynamicResource Label}" />
                                    <TextBlock x:Name="OverlayState" Foreground="{DynamicResource Good}"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Text="Checking..." />
                                    <TextBlock x:Name="OverlayDetail" Style="{DynamicResource StatusTextStyle}"
                                               Margin="0,10,32,0" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>

                                <Button x:Name="FixButton" Grid.Column="1" Content="Repair"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="OnRepairClick" Padding="18,8" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PAGE: DISPLAY ================= -->
                    <Grid x:Name="PageDisplay" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Display Mode" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,24" />

                        <!-- Three GPU Mode Option Cards in a Row (None checked by default) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- 1. Discrete GPU -->
                            <RadioButton x:Name="ModeDiscrete" Style="{DynamicResource GpuOptionCard}"
                                         Tag="Discrete" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuDiscrete}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Discrete GPU" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                                    <TextBlock Text="Dedicated graphics only"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. MS Hybrid -->
                            <RadioButton x:Name="ModeHybrid" Style="{DynamicResource GpuOptionCard}"
                                         Tag="Hybrid" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuHybrid}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="MS Hybrid" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                                    <TextBlock Text="Dynamic graphics switching"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. UMA Mode -->
                            <RadioButton x:Name="ModeUma" Style="{DynamicResource GpuOptionCard}"
                                         Tag="Uma" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{DynamicResource IconGpuUma}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" />
                                    <TextBlock Text="UMA Mode" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                                    <TextBlock Text="Integrated graphics only"
                                               Style="{DynamicResource StatusTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Explanation -->
                        <TextBlock x:Name="GpuModeDetail" Grid.Row="2" Style="{DynamicResource StatusTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="680" LineHeight="20" />
                    </Grid>

                    <!-- ================= PAGE: LIGHTING ================= -->
                    <Grid x:Name="PageLighting" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="316" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Zone Tabs, Realistic G870 Laptop Hardware Keyboard Backlight Preview, Profile Row -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Zone Selection Tabs -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="TabZoneA" Style="{DynamicResource ZoneTab}" Content="Zone A"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Left" />
                                <RadioButton x:Name="TabZoneB" Style="{DynamicResource ZoneTab}" Content="Zone B"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Middle" />
                                <RadioButton x:Name="TabZoneC" Style="{DynamicResource ZoneTab}" Content="Zone C"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Right" />
                            </StackPanel>

                            <!-- Authentic Casper Excalibur G870 Laptop Chassis & 3-Zone Keyboard Backlight Preview -->
                            <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="8">
                                <Grid VerticalAlignment="Center">
                                    <!-- Laptop Deck Enclosure (Metallic anodized titanium/silver finish with bevels) -->
                                    <Border CornerRadius="8" Padding="10,8,10,8"
                                            BorderThickness="1.5" BorderBrush="{DynamicResource CardBorder}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2C2F38" Offset="0.0" />
                                                <GradientStop Color="#202229" Offset="0.25" />
                                                <GradientStop Color="#181A20" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /> <!-- Top Exhaust Vents & Power Shield Bar -->
                                                <RowDefinition Height="Auto" /> <!-- Recessed Keyboard Well with 3 Zones -->
                                                <RowDefinition Height="Auto" /> <!-- Palm Rest & Centered Touchpad -->
                                            </Grid.RowDefinitions>

                                            <!-- Top Vent Grille & Power Shield -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <!-- Dark Red Accent Grille Strip -->
                                                <Border Background="#8A180E" Height="4" VerticalAlignment="Top"
                                                        HorizontalAlignment="Stretch" Margin="36,0,36,0" CornerRadius="2" />
                                                <!-- Center Power Shield Indicator -->
                                                <Path Data="M 0,0 L 12,0 L 6,8 Z" Fill="{DynamicResource Muted}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                                            </Grid>

                                            <!-- Recessed Keyboard Well: Houses 3 Authentic Hardware Vector Backlight Zones -->
                                            <Border Grid.Row="1" Background="#0A0B0E" BorderBrush="#161822"
                                                    BorderThickness="1" CornerRadius="4" Padding="3"
                                                    HorizontalAlignment="Center">
                                                <Grid Width="457" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="152.333" />
                                                        <ColumnDefinition Width="152.333" />
                                                        <ColumnDefinition Width="152.334" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ================= ZONE A: LEFT KEYBOARD ================= -->
                                                    <Border x:Name="PreviewA" Grid.Column="0" CornerRadius="3"
                                                            BorderThickness="1.5" BorderBrush="{DynamicResource Accent}"
                                                            Background="#FFFFFF" SnapsToDevicePixels="True">
                                                        <Grid ClipToBounds="True" Background="#0A0B0E">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewA}" Opacity="0.12" />
                                                            <!-- Vector Keycap Outlines (docs/keyboard_layout.svg - Left Zone) -->
                                                            <Canvas Width="457" Height="140" HorizontalAlignment="Left">
                                                                <Path Data="{StaticResource KeyboardGeometry}"
                                                                      Stroke="{Binding Background, ElementName=PreviewA}"
                                                                      StrokeThickness="1"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      SnapsToDevicePixels="True" />
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ================= ZONE B: MIDDLE KEYBOARD ================= -->
                                                    <Border x:Name="PreviewB" Grid.Column="1" CornerRadius="3"
                                                            BorderThickness="1.5" BorderBrush="Transparent"
                                                            Background="#FFFFFF" SnapsToDevicePixels="True">
                                                        <Grid ClipToBounds="True" Background="#0A0B0E">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewB}" Opacity="0.12" />
                                                            <!-- Vector Keycap Outlines (docs/keyboard_layout.svg - Middle Zone) -->
                                                            <Canvas Width="457" Height="140" HorizontalAlignment="Left" Margin="-152.333,0,0,0">
                                                                <Path Data="{StaticResource KeyboardGeometry}"
                                                                      Stroke="{Binding Background, ElementName=PreviewB}"
                                                                      StrokeThickness="1"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      SnapsToDevicePixels="True" />
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ================= ZONE C: RIGHT KEYBOARD ================= -->
                                                    <Border x:Name="PreviewC" Grid.Column="2" CornerRadius="3"
                                                            BorderThickness="1.5" BorderBrush="Transparent"
                                                            Background="#FFFFFF" SnapsToDevicePixels="True">
                                                        <Grid ClipToBounds="True" Background="#0A0B0E">
                                                            <!-- Diffuse Backlight Underglow Layer -->
                                                            <Border Background="{Binding Background, ElementName=PreviewC}" Opacity="0.12" />
                                                            <!-- Vector Keycap Outlines (docs/keyboard_layout.svg - Right Zone) -->
                                                            <Canvas Width="457" Height="140" HorizontalAlignment="Left" Margin="-304.667,0,0,0">
                                                                <Path Data="{StaticResource KeyboardGeometry}"
                                                                      Stroke="{Binding Background, ElementName=PreviewC}"
                                                                      StrokeThickness="1"
                                                                      StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      SnapsToDevicePixels="True" />
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Palm Rest & Precision Touchpad -->
                                            <Border Grid.Row="2" Height="52" Margin="0,6,0,0">
                                                <Border Width="154" Height="44" HorizontalAlignment="Center"
                                                        CornerRadius="4" BorderThickness="1.2"
                                                        BorderBrush="#FFFFFF" Background="#161820" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bottom: Lighting Profile Buttons (Office, Gaming, Performance, User Define) -->
                            <StackPanel x:Name="ProfileRow" Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,10,0,0">
                                <RadioButton x:Name="ProfOffice" Style="{DynamicResource ProfileButton}" Content="Office"
                                             Tag="Office" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfGaming" Style="{DynamicResource ProfileButton}" Content="Gaming"
                                             Tag="Gaming" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfPerformance" Style="{DynamicResource ProfileButton}" Content="Performance"
                                             Tag="Performance" GroupName="Profile" Checked="OnProfileChecked" />
                                <RadioButton x:Name="ProfUser" Style="{DynamicResource ProfileButton}" Content="User Define"
                                             Tag="UserDefine" GroupName="Profile" Checked="OnProfileChecked" />
                            </StackPanel>
                        </Grid>

                        <!-- Right: Master Switches, Effects Grid, Color Wheel, Brightness Slider -->
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Background="{DynamicResource PanelBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Master switches -->
                                    <RowDefinition Height="Auto" /> <!-- Divider -->
                                    <RowDefinition Height="Auto" /> <!-- Effects Panel -->
                                    <RowDefinition Height="*" />    <!-- Color Wheel & Brightness Slider -->
                                </Grid.RowDefinitions>

                                <!-- 1. Master Switches (LED on/off, Select all, Reload) -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LED on/off -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <ToggleButton x:Name="LedPower" Style="{DynamicResource Pill}"
                                                      Click="OnLedPowerToggled" />
                                        <TextBlock Text="LED on/off" Style="{DynamicResource Label}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Select all -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <ToggleButton x:Name="SelectAll" Style="{DynamicResource Pill}"
                                                      Click="OnSelectAllToggled" />
                                        <TextBlock Text="Select all" Style="{DynamicResource Label}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Reload Button -->
                                    <Button x:Name="ReloadButton" Grid.Column="2" Click="OnReloadClick"
                                            VerticalAlignment="Top" Margin="0,2,4,0" ToolTip="Reload settings">
                                        <Path Data="{DynamicResource IconReload}" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="0,6,0,10" />

                                <!-- 2. Lighting Effect Selection (Static, Breathing, Blink, Heartbeat, Cycle, Wave) -->
                                <UniformGrid x:Name="EffectPanel" Grid.Row="2" Columns="3" Margin="0,0,0,6">
                                    <RadioButton x:Name="FxStatic" Style="{DynamicResource EffectButton}" Content="Static"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxStatic}" />
                                    <RadioButton x:Name="FxBreathing" Style="{DynamicResource EffectButton}" Content="Breathing"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxBreathing}" />
                                    <RadioButton x:Name="FxBlink" Style="{DynamicResource EffectButton}" Content="Blink"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxBlink}" />
                                    <RadioButton x:Name="FxHeartbeat" Style="{DynamicResource EffectButton}" Content="Heartbeat"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxHeartbeat}" />
                                    <RadioButton x:Name="FxCycle" Style="{DynamicResource EffectButton}" Content="Colour cycle"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxCycle}" />
                                    <RadioButton x:Name="FxWave" Style="{DynamicResource EffectButton}" Content="Wave"
                                                 GroupName="Fx" Checked="OnEffectChecked"
                                                 Tag="{DynamicResource IconFxWave}" />
                                </UniformGrid>

                                <!-- 3. Polar Color Wheel & Brightness Slider -->
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Color Wheel & Hint Message -->
                                    <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <c:ColourWheel x:Name="Wheel" Width="140" Height="140"
                                                       ColourPicked="OnColourPicked" />
                                        <TextBlock x:Name="WheelHint" Style="{DynamicResource Label}" Margin="0,4,0,0"
                                                   Text="Fixed colour cycle" Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>

                                    <!-- Brightness Slider & Readout -->
                                    <StackPanel Grid.Row="1" Margin="6,6,6,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Brightness" Style="{DynamicResource Label}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BrightnessValue" Text="100%"
                                                       Style="{DynamicResource Value}" FontSize="13"
                                                       Foreground="{DynamicResource Ink}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                ValueChanged="OnBrightnessChanged" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
