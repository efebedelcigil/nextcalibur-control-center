<Window x:Class="Nextcalibur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nextcalibur.App.Controls"
        Title="Nextcalibur Control Center"
        Width="1024" Height="556"
        ResizeMode="NoResize" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:TemperatureToDoubleConverter x:Key="TemperatureToDoubleConverter" />
            <c:RpmToDoubleConverter x:Key="RpmToDoubleConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Window Border with Square Corners (0px) -->
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0"
                  Background="{StaticResource TitleBarBackground}"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: LogoMark + Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="{StaticResource LogoMarkGeometry}" Fill="#FFFFFF"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="NEXTCALIBUR  CONTROL CENTER"
                               Style="{StaticResource WordmarkTextStyle}" />
                </StackPanel>

                <!-- Center/Right: Abstract Copper Circuit Header Artwork with Gradient Fade -->
                <Viewbox Grid.Column="2" Stretch="UniformToFill" Width="380" Height="36"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Viewbox.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                            <GradientStop Color="#FF000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Viewbox.OpacityMask>
                    <Image Source="{StaticResource HeaderCircuitImage}" Width="380" Height="36" />
                </Viewbox>

                <!-- Right: Caption Buttons (Minimise & Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimiseClick"
                            Tag="{StaticResource IconMinimise}" ToolTip="Minimise" />
                    <Button Style="{StaticResource CloseButton}" Click="OnCloseClick"
                            Tag="{StaticResource IconClose}" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail (4 items: System, Power Mode, Display, Lighting) -->
                <Border Grid.Column="0" Background="{StaticResource RailBackground}"
                        BorderBrush="{StaticResource RailBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Rail Wordmark -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,14,0,14">
                            <TextBlock Text="NEXT" Foreground="{StaticResource Accent}"
                                       FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="CALIBUR" Foreground="{StaticResource Ink}"
                                       FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>

                        <!-- Nav Rail Buttons -->
                        <StackPanel Grid.Row="1">
                            <!-- 1. System -->
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="System"
                                         GroupName="Nav" IsChecked="True" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavSystem}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>

                            <!-- 2. Power Mode (Relabelled & redrawn unambiguous power plug) -->
                            <RadioButton x:Name="NavPower" Style="{StaticResource NavItem}" Tag="Power Mode"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavPower}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>

                            <!-- 3. Display Mode -->
                            <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}" Tag="Display"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavDisplay}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>

                            <!-- 4. Lighting -->
                            <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" Tag="Lighting"
                                         GroupName="Nav" Checked="OnNavChanged">
                                <Path Data="{StaticResource IconNavLighting}" Width="24" Height="22" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeEndLineCap="Round" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area Container -->
                <Grid Grid.Column="1" Margin="18,12,18,14">

                    <!-- ================= PAGE: SYSTEM ================= -->
                    <Grid x:Name="PageSystem" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- System Mode Tabs Across Top (y=61-111, None checked by default) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Office Mode -->
                            <RadioButton x:Name="ModeOffice" Style="{StaticResource SystemModeTab}"
                                         Tag="Office" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconModeOffice}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Office" FontSize="12.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Gaming Mode -->
                            <RadioButton x:Name="ModeGaming" Style="{StaticResource SystemModeTab}"
                                         Tag="Gaming" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconModeGaming}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Gaming" FontSize="12.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- High Performance Mode -->
                            <RadioButton x:Name="ModePerformance" Style="{StaticResource SystemModeTab}"
                                         Tag="Performance" GroupName="Mode" Checked="OnSystemModeChanged">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconModePerformance}" Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="High Performance" FontSize="12.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- System Sensors & Gauges Area -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Header, Warning Banner, Center Fan Gauges -->
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header & Subtitle (Human text: System / Starting up...) -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="System" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock x:Name="SubtitleText" Style="{StaticResource StatusTextStyle}"
                                               Margin="0,2,0,0" Text="Starting up..." />
                                </StackPanel>

                                <!-- Warning Banner (starts Collapsed) -->
                                <Border x:Name="Banner" Grid.Row="1" Style="{StaticResource Card}"
                                        Margin="0,0,0,10" Visibility="Collapsed" BorderBrush="{StaticResource Warn}">
                                    <StackPanel>
                                        <TextBlock x:Name="BannerTitle" Foreground="{StaticResource Warn}"
                                                   FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BannerBody" Style="{StaticResource StatusTextStyle}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Center Fan Gauges Dashboard -->
                                <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="235" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="235" />
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU Fan & Temp Unit -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <c:FanGauge x:Name="CpuFanGauge" Width="170" Height="170"
                                                        Value="{Binding Text, ElementName=CpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                        Maximum="6000"
                                                        ArcBrush="{StaticResource Accent}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0">
                                                    <TextBlock x:Name="CpuFan" Text="-- rpm"
                                                               Style="{StaticResource Value}" FontSize="20"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="CPU FAN" Style="{StaticResource Label}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </c:FanGauge>

                                            <Border Background="{StaticResource PanelBackground}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="5" Padding="10,6" Margin="0,12,0,0" Width="170">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Label}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="CpuTemp" Text="-- °C"
                                                               Style="{StaticResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Subtle Divider -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"
                                                Height="220" HorizontalAlignment="Center" />

                                        <!-- GPU Fan & Temp Unit -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <c:FanGauge x:Name="GpuFanGauge" Width="170" Height="170"
                                                        Value="{Binding Text, ElementName=GpuFan, Converter={StaticResource RpmToDoubleConverter}}"
                                                        Maximum="6000"
                                                        ArcBrush="{StaticResource Accent}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0">
                                                    <TextBlock x:Name="GpuFan" Text="-- rpm"
                                                               Style="{StaticResource Value}" FontSize="20"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="GPU FAN" Style="{StaticResource Label}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </c:FanGauge>

                                            <Border Background="{StaticResource PanelBackground}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="5" Padding="10,6" Margin="0,12,0,0" Width="170">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Label}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="GpuTemp" Text="-- °C"
                                                               Style="{StaticResource Value}" FontSize="22"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Right Column: Chamfered Panels for CPU & GPU and Memory & Disk -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Panel 1: CPU & GPU -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Chamfered Header Tab -->
                                    <Border Grid.Row="0" Background="{StaticResource HeaderTabBackground}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0"
                                            HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                            CornerRadius="4,12,0,0">
                                        <TextBlock Text="CPU &amp; GPU" Style="{StaticResource PanelHeaderTextStyle}" />
                                    </Border>

                                    <!-- Panel Content Card -->
                                    <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="0,6,6,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <!-- CPU Row -->
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" />
                                                    <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text, ElementName=CpuTemp}"
                                                           Foreground="{Binding Foreground, ElementName=CpuTemp}"
                                                           FontWeight="Bold" FontSize="17" HorizontalAlignment="Right" />
                                            </Grid>
                                            <c:SegmentedBar Value="{Binding Text, ElementName=CpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                            Minimum="0" Maximum="100" SegmentCount="16" Height="10"
                                                            LitBrush="{Binding Foreground, ElementName=CpuTemp}" />

                                            <!-- GPU Row -->
                                            <Grid Margin="0,16,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" />
                                                    <TextBlock Text="GPU" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text, ElementName=GpuTemp}"
                                                           Foreground="{Binding Foreground, ElementName=GpuTemp}"
                                                           FontWeight="Bold" FontSize="17" HorizontalAlignment="Right" />
                                            </Grid>
                                            <c:SegmentedBar Value="{Binding Text, ElementName=GpuTemp, Converter={StaticResource TemperatureToDoubleConverter}}"
                                                            Minimum="0" Maximum="100" SegmentCount="16" Height="10"
                                                            LitBrush="{Binding Foreground, ElementName=GpuTemp}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Panel 2: Memory & Disk -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Chamfered Header Tab -->
                                    <Border Grid.Row="0" Background="{StaticResource HeaderTabBackground}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0"
                                            HorizontalAlignment="Left" Padding="14,0,24,0" Height="24"
                                            CornerRadius="4,12,0,0">
                                        <TextBlock Text="Memory &amp; Disk" Style="{StaticResource PanelHeaderTextStyle}" />
                                    </Border>

                                    <!-- Donut Gauges Card -->
                                    <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="0,6,6,6">
                                        <UniformGrid Columns="2" VerticalAlignment="Center">
                                            <!-- RAM Donut -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <c:DonutGauge Value="42" Maximum="100" Width="78" Height="78"
                                                              ArcBrush="{StaticResource Accent}" StrokeThickness="7" />
                                                <TextBlock Text="RAM" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <TextBlock Text="42%" Style="{StaticResource Value}" FontSize="15"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- SSD Donut -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <c:DonutGauge Value="68" Maximum="100" Width="78" Height="78"
                                                              ArcBrush="{StaticResource Accent}" StrokeThickness="7" />
                                                <TextBlock Text="SSD" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <TextBlock Text="68%" Style="{StaticResource Value}" FontSize="15"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE: POWER ================= -->
                    <Grid x:Name="PagePower" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header rewritten: Power Mode -->
                        <TextBlock Grid.Row="0" Text="Power Mode" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,16" />

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid VerticalAlignment="Center" Margin="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Label rewritten: CURRENT MODE -->
                                    <TextBlock Text="CURRENT MODE" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="OverlayState" Foreground="{StaticResource Good}"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Text="Checking..." />
                                    <TextBlock x:Name="OverlayDetail" Style="{StaticResource StatusTextStyle}"
                                               Margin="0,10,32,0" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>

                                <Button x:Name="FixButton" Grid.Column="1" Content="Repair"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="OnRepairClick" Padding="18,8" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= PAGE: DISPLAY ================= -->
                    <Grid x:Name="PageDisplay" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Display Mode" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,24" />

                        <!-- Three GPU Mode Option Cards in a Row (None checked by default) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- 1. Discrete GPU -->
                            <RadioButton x:Name="ModeDiscrete" Style="{StaticResource GpuOptionCard}"
                                         Tag="Discrete" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGpuDiscrete}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          HorizontalAlignment="Center" Margin="0,10,0,24" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="16" Height="16" Margin="0,0,8,0"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                 StrokeThickness="1.8" Fill="Transparent" />
                                        <TextBlock Text="Discrete GPU"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   FontSize="13.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. MS Hybrid -->
                            <RadioButton x:Name="ModeHybrid" Style="{StaticResource GpuOptionCard}"
                                         Tag="Hybrid" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGpuHybrid}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          HorizontalAlignment="Center" Margin="0,10,0,24" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="16" Height="16" Margin="0,0,8,0"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                 StrokeThickness="1.8" Fill="Transparent" />
                                        <TextBlock Text="MS Hybrid"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   FontSize="13.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. UMA Mode -->
                            <RadioButton x:Name="ModeUma" Style="{StaticResource GpuOptionCard}"
                                         Tag="Uma" GroupName="Gpu" Checked="OnGpuModeChanged">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGpuUma}" Width="68" Height="68" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          HorizontalAlignment="Center" Margin="0,10,0,24" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="16" Height="16" Margin="0,0,8,0"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                 StrokeThickness="1.8" Fill="Transparent" />
                                        <TextBlock Text="UMA Mode"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   FontSize="13.5" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Explanation Line -->
                        <TextBlock x:Name="GpuModeDetail" Grid.Row="2" Style="{StaticResource StatusTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,28,0,0" TextWrapping="Wrap" />
                    </Grid>

                    <!-- ================= PAGE: LIGHTING ================= -->
                    <Grid x:Name="PageLighting" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="316" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Zone Tabs, Actual G870 Laptop Hardware Keyboard Backlight Preview, Profile Row -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Zone Selection Tabs -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="TabZoneA" Style="{StaticResource ZoneTab}" Content="Zone A"
                                             GroupName="Zone" IsChecked="True" Checked="OnZoneTabChanged" Tag="Left" />
                                <RadioButton x:Name="TabZoneB" Style="{StaticResource ZoneTab}" Content="Zone B"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Middle" />
                                <RadioButton x:Name="TabZoneC" Style="{StaticResource ZoneTab}" Content="Zone C"
                                             GroupName="Zone" Checked="OnZoneTabChanged" Tag="Right" />
                            </StackPanel>

                            <!-- Authentic Casper Excalibur G870 Laptop Chassis & 3-Zone Keyboard Backlight Preview -->
