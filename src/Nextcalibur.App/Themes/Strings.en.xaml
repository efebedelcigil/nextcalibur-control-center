    <sys:String x:Key="S.Settings.IdleLoadTitle">Efficiency mode</sys:String>
    <sys:String x:Key="S.Settings.IdleLoadDesc">Scan lists background programs that keep working while nobody uses the computer. A ticked program runs in Windows' Efficiency mode and heats the processor less; nothing is closed.</sys:String>
