    <sys:String x:Key="S.Settings.FixWidgetsDesc">Restarts the Widgets board if it gets stuck using the processor.</sys:String>
    <sys:String x:Key="S.Settings.WatchGpuAwakeTitle">Warn when the graphics card is kept awake</sys:String>
    <sys:String x:Key="S.Settings.WatchGpuAwakeDesc">Tells you when a background program keeps the NVIDIA card from sleeping.</sys:String>
    <sys:String x:Key="S.Settings.TrimDwmMemoryTitle">Desktop manager (dwm.exe) memory</sys:String>
    <sys:String x:Key="S.Settings.TrimDwmMemoryDesc">Frees the desktop manager's leaked memory past 1.5 GB, without closing any window.</sys:String>
    <sys:String x:Key="S.Settings.TrimExplorerMemoryTitle">Explorer (explorer.exe) memory</sys:String>
    <sys:String x:Key="S.Settings.TrimExplorerMemoryDesc">Frees Explorer's swollen cache past 1.2 GB, without restarting the taskbar.</sys:String>
