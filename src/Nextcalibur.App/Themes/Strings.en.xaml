    <sys:String x:Key="S.CeilingTest.ApplyBody">{0}'s ceiling will be written into its plan as {1}. You can change it in Settings at any time.</sys:String>
    <sys:String x:Key="S.CeilingTest.SuggestTitle">The machine has been running hot often lately</sys:String>
