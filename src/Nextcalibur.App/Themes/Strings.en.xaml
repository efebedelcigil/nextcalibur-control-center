    <sys:String x:Key="S.Core.Overlay.Unknown">Unrecognised</sys:String>
    <sys:String x:Key="S.Core.Overlay.EfficiencyDesc">Longest battery life, quietest fans. Heavy work takes longer.</sys:String>
    <sys:String x:Key="S.Core.Overlay.BalancedDesc">Windows decides: fast when needed, calm otherwise.</sys:String>
    <sys:String x:Key="S.Core.Overlay.BetterDesc">Quicker under load; a little warmer and louder.</sys:String>
