    <sys:String x:Key="S.Settings.GroupGpu">Graphics card</sys:String>
    <sys:String x:Key="S.Settings.NvPowerTitle">NVIDIA power management mode</sys:String>
    <sys:String x:Key="S.Settings.NvPowerDesc">NVIDIA Control Panel's global setting. "Normal" lets the card slow down at idle and still reach full speed in games; "Prefer maximum performance" keeps it hot for nothing.</sys:String>
    <sys:String x:Key="S.NvPower.Normal">Normal (recommended)</sys:String>
    <sys:String x:Key="S.NvPower.Adaptive">Adaptive</sys:String>
    <sys:String x:Key="S.NvPower.Maximum">Prefer maximum performance</sys:String>
    <sys:String x:Key="S.NvPower.Unavailable">Could not be read from the NVIDIA driver.</sys:String>
    <sys:String x:Key="S.NvPower.ConfirmTitle">Change NVIDIA's power management mode?</sys:String>
    <sys:String x:Key="S.NvPower.ConfirmBody">This changes the NVIDIA driver's global setting - the same one as in its Control Panel. Per-game settings stay as they are.</sys:String>
    <sys:String x:Key="S.NvPower.Failed">The NVIDIA driver did not accept the setting; it was not changed.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingNvPower.Title">NVIDIA power management mode</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingNvPower.Body">NVIDIA's global power setting without the Control Panel. "Prefer maximum performance" keeps the card at full clock and warm at idle; "Normal" costs nothing in a game.</sys:String>
