    <sys:String x:Key="S.Idle.ScreenSaver">Screen saver</sys:String>
    <sys:String x:Key="S.Idle.ScreenSaverDesc">Windows keeps one time for it, the same in every mode and on battery.</sys:String>
    <sys:String x:Key="S.Idle.Never">Never</sys:String>
    <sys:String x:Key="S.Idle.Off">Off</sys:String>
