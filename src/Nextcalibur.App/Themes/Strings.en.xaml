    <!-- Windows' own faults -->
    <sys:String x:Key="S.Core.Fault.InputHost">Windows' input host (TextInputHost) was stuck using a whole processor core. Nextcalibur restarted it; Windows starts it again by itself when the touch keyboard or the emoji panel is needed.</sys:String>
    <sys:String x:Key="S.Core.Fault.CrossDevice">Windows' Phone Link service (CrossDeviceService) was stuck in a background processor loop. Nextcalibur restarted it; Windows starts it again on demand.</sys:String>
    <sys:String x:Key="S.Core.Fault.Widgets">Windows' Widgets board (Widgets) was stuck in a background processor loop. Nextcalibur restarted it; Windows starts it again when opened.</sys:String>
