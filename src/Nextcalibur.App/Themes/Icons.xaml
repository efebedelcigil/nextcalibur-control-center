<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Toggle Icons (24x24 viewBox standard) -->
    <!-- Dark Theme: Crescent Moon -->
    <StreamGeometry x:Key="IconThemeDark">
        M 21,12.79 A 9,9 0 1 1 11.21,3 A 7,7 0 0 0 21,12.79 Z
    </StreamGeometry>

    <!-- Light Theme: Sun with Radiant Rays -->
    <StreamGeometry x:Key="IconThemeLight">
        M 12,7 A 5,5 0 1 0 12,17 A 5,5 0 1 0 12,7 Z M 12,1 V 3 M 12,21 V 23 M 4.22,4.22 L 5.64,5.64 M 18.36,18.36 L 19.78,19.78 M 1,12 H 3 M 21,12 H 23 M 4.22,19.78 L 5.64,18.36 M 18.36,5.64 L 19.78,4.22
    </StreamGeometry>

    <!-- System Theme: Half-filled Circle (Left Solid, Right Ring) -->
    <StreamGeometry x:Key="IconThemeSystem">
        M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 12,4 A 8,8 0 1 0 12,20 A 8,8 0 1 0 12,4 Z M 12,4 A 8,8 0 0 0 12,20 Z
    </StreamGeometry>

    <!-- Navigation Rail Icons (24x24 viewBox standard) -->
    <!-- System Sensor Dashboard / Gauge -->
    <StreamGeometry x:Key="IconNavSystem">
        M 4,16 A 9,9 0 1 1 20,16 M 12,12 L 16,7 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z
    </StreamGeometry>

    <!-- Power Plug with Gauge Arc (Unambiguous Power Mode Icon) -->
    <StreamGeometry x:Key="IconNavPower">
        M 8,3 V 7 M 16,3 V 7 M 5,7 H 19 V 12 A 7,7 0 0 1 13,19 V 22 H 11 V 19 A 7,7 0 0 1 5,12 Z M 9,13 A 3,3 0 0 1 15,13
    </StreamGeometry>

    <!-- Display Clamshell Laptop with Dual Pane Screen -->
    <StreamGeometry x:Key="IconNavDisplay">
        M 4,4 H 20 V 16 H 4 Z M 2,18 H 22 L 20,20 H 4 Z M 12,4 V 16 M 7,9 H 9 M 15,8 H 17 M 16,7 V 9
    </StreamGeometry>

    <!-- Keyboard Lighting Emitter -->
    <StreamGeometry x:Key="IconNavLighting">
        M 12,2 A 6.5,6.5 0 0 0 7,13 V 16 H 17 V 13 A 6.5,6.5 0 0 0 12,2 Z M 8.5,19 H 15.5 M 9.5,21.5 H 14.5
    </StreamGeometry>

    <!-- System Mode Tab Icons (24x24 standard) -->
    <!-- Office Mode: Monitor with document lines -->
    <StreamGeometry x:Key="IconModeOffice">
        M 3,4 H 21 V 16 H 3 Z M 8,20 H 16 M 12,16 V 20 M 6,8 H 18 M 6,11 H 15 M 6,13 H 11
    </StreamGeometry>

    <!-- Gaming Mode: Console Gamepad Controller -->
    <StreamGeometry x:Key="IconModeGaming">
        M 6,8 H 18 A 4,4 0 0 1 22,12 C 22,17 19,20 17,20 C 15.5,20 14.5,18.5 13.5,17 H 10.5 C 9.5,18.5 8.5,20 7,20 C 5,20 2,17 2,12 A 4,4 0 0 1 6,8 Z M 6,12 H 10 M 8,10 V 14 M 16,11 A 1,1 0 1 0 16,13 A 1,1 0 0 0 16,11 Z M 18,13 A 1,1 0 1 0 18,15 A 1,1 0 0 0 18,13 Z
    </StreamGeometry>

    <!-- High Performance Mode: Tachometer at Redline -->
    <StreamGeometry x:Key="IconModePerformance">
        M 4,16 A 9,9 0 1 1 20,16 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z M 12,11 L 18,7.5 M 16,5 L 18,7 M 19,8 L 21,9
    </StreamGeometry>

    <!-- GPU Display Mode Card Illustrations -->
    <!-- Discrete GPU: Stylized multi-blade cooling turbine with GPU hub -->
    <StreamGeometry x:Key="IconGpuDiscrete">
        M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 Z M 12,2 C 14,5 14,7 12,7 M 19,5 C 18,8 16,9 15.5,8 M 22,12 C 19,14 17,14 17,12 M 19,19 C 16,18 15,16 15.5,15.5 M 12,22 C 10,19 10,17 12,17 M 5,19 C 6,16 8,15 8.5,16 M 2,12 C 5,10 7,10 7,12 M 5,5 C 8,6 9,8 8.5,8.5
    </StreamGeometry>

    <!-- MS Hybrid: Turbine on left linked to chip on right via curved arrows -->
    <StreamGeometry x:Key="IconGpuHybrid">
        M 7,7 A 4.5,4.5 0 1 1 7,16 A 4.5,4.5 0 1 1 7,7 Z M 15,8 H 21 V 15 H 15 Z M 15,11.5 H 21 M 18,8 V 15 M 7,5 C 10,3.5 14,4 16,6.5 M 14,6.5 H 17 V 3.5 M 17,17.5 C 14,20 10,19.5 7,18 M 9,18 H 6 V 21
    </StreamGeometry>

    <!-- UMA Mode: Semiconductor processor chip with lightning bolt -->
    <StreamGeometry x:Key="IconGpuUma">
        M 5,5 H 19 V 19 H 5 Z M 8,2 V 5 M 12,2 V 5 M 16,2 V 5 M 8,19 V 22 M 12,19 V 22 M 16,19 V 22 M 2,8 H 5 M 2,12 H 5 M 2,16 H 5 M 19,8 H 22 M 19,12 H 22 M 19,16 H 22 M 13,7 L 9,12.5 H 13 L 11,17 L 16,11.5 H 12 Z
    </StreamGeometry>

    <!-- Windows Power Mode Option Card Illustrations -->
    <!-- 1. Efficiency / Power Saver: Eco Leaf with Stem -->
    <StreamGeometry x:Key="IconPowerSaver">
        M 17,8 C 17,4 13,2 8,2 C 7,8 7,13 11,17 C 12,18 13.5,19 15.5,19 C 18,19 20,17 20,14.5 C 20,12 18.5,10 17,8 Z M 8,2 C 10,7 13,10 18,11 M 11,17 L 7,21
    </StreamGeometry>

    <!-- 2. Balanced: Centered Dial / Balanced Meter (Needle at 12 o'clock) -->
    <StreamGeometry x:Key="IconPowerBalanced">
        M 4,16 A 9,9 0 1 1 20,16 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z M 12,10 V 5 M 8,6.5 L 9,8 M 16,6.5 L 15,8
    </StreamGeometry>

    <!-- 3. Better Performance: Accelerated Tachometer Needle -->
    <StreamGeometry x:Key="IconPowerPerformance">
        M 4,16 A 9,9 0 1 1 20,16 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z M 12,11 L 18,7.5 M 15,5 L 17,7 M 18.5,8 L 20.5,9
    </StreamGeometry>

    <!-- 4. Best Performance: High Energy Lightning Bolt -->
    <StreamGeometry x:Key="IconPowerBest">
        M 13,2 L 5,13 H 12 L 10,22 L 20,10 H 13 Z
    </StreamGeometry>


    <!-- Radio Indicator Geometries for Option Cards -->
    <StreamGeometry x:Key="IconRadioUnchecked">
        M 12,3 A 9,9 0 1 1 12,21 A 9,9 0 1 1 12,3 Z
    </StreamGeometry>
    <StreamGeometry x:Key="IconRadioChecked">
        M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 7.5,12 L 10.5,15 L 16.5,9
    </StreamGeometry>

    <!-- Window Caption Icons -->
    <StreamGeometry x:Key="IconMinimise">
        M 0,5 H 10
    </StreamGeometry>

    <StreamGeometry x:Key="IconClose">
        M 1,1 L 9,9 M 9,1 L 1,9
    </StreamGeometry>

    <!-- Lighting Effect Icons (24x24 viewBox standard) -->
    <!-- 1. Static: Constant luminescent glow -->
    <StreamGeometry x:Key="IconFxStatic">
        M 12,6 A 6,6 0 1 1 12,18 A 6,6 0 1 1 12,6 Z M 12,2 V 4 M 12,20 V 22 M 2,12 H 4 M 20,12 H 22
    </StreamGeometry>

    <!-- 2. Breathing: Smooth sinusoidal wave cycle -->
    <StreamGeometry x:Key="IconFxBreathing">
        M 2,12 C 5,2 8,2 12,12 C 16,22 19,22 22,12
    </StreamGeometry>

    <!-- 3. Blink: Digital square wave hard on / hard off -->
    <StreamGeometry x:Key="IconFxBlink">
        M 2,18 H 6 V 6 H 12 V 18 H 18 V 6 H 22
    </StreamGeometry>

    <!-- 4. Heartbeat: Sharp double-pulse ECG cardiogram -->
    <StreamGeometry x:Key="IconFxHeartbeat">
        M 1,13 H 5 L 7,8 L 10,19 L 13,4 L 16,16 L 18,13 H 23
    </StreamGeometry>

    <!-- 5. Colour cycle: Dual looping arrows -->
    <StreamGeometry x:Key="IconFxCycle">
        M 19.5,12 A 7.5,7.5 0 1 1 12,4.5 M 12,1 L 12,5 L 16,3 M 12,19.5 A 7.5,7.5 0 0 1 4.5,12 M 12,23 L 12,19 L 8,21
    </StreamGeometry>

    <!-- 6. Wave: Progressive ripples across keys -->
    <StreamGeometry x:Key="IconFxWave">
        M 2,8 C 5,3 8,13 12,8 C 16,3 19,13 22,8 M 2,16 C 5,11 8,21 12,16 C 16,11 19,21 22,16
    </StreamGeometry>

    <!-- Utility & Status Icons -->
    <StreamGeometry x:Key="IconReload">
        M 18.5,8 A 7,7 0 1 0 19,12 M 19,4 V 8.5 H 14.5
    </StreamGeometry>

    <StreamGeometry x:Key="IconStatusDot">
        M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 Z
    </StreamGeometry>

</ResourceDictionary>
