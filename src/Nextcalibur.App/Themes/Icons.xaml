<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Original Nextcalibur Blade Brand Mark (Single-weight, works crisply at 16-256px) -->
    <StreamGeometry x:Key="LogoMarkGeometry">
        M 16,1 L 21.2,12.1 L 28.2,21.0 L 20,23.5 L 16,18 L 12,23.5 L 3.8,21.0 L 10.8,12.1 Z
    </StreamGeometry>

    <!-- Navigation Rail Icons (24x24 viewBox standard) -->
    <!-- System Sensor Dashboard / Gauge -->
    <StreamGeometry x:Key="IconNavSystem">
        M 4,16 A 9,9 0 1 1 20,16 M 12,12 L 16,7 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z
    </StreamGeometry>

    <!-- Power Plug with Gauge Arc (Unambiguous Power Mode Icon) -->
    <StreamGeometry x:Key="IconNavPower">
        M 8,3 V 7 M 16,3 V 7 M 5,7 H 19 V 12 A 7,7 0 0 1 13,19 V 22 H 11 V 19 A 7,7 0 0 1 5,12 Z M 9,13 A 3,3 0 0 1 15,13
    </StreamGeometry>

    <!-- Display Clamshell Laptop with Dual Pane Screen -->
    <StreamGeometry x:Key="IconNavDisplay">
        M 4,4 H 20 V 16 H 4 Z M 2,18 H 22 L 20,20 H 4 Z M 12,4 V 16 M 7,9 H 9 M 15,8 H 17 M 16,7 V 9
    </StreamGeometry>

    <!-- Keyboard Lighting Emitter -->
    <StreamGeometry x:Key="IconNavLighting">
        M 12,2 A 6.5,6.5 0 0 0 7,13 V 16 H 17 V 13 A 6.5,6.5 0 0 0 12,2 Z M 8.5,19 H 15.5 M 9.5,21.5 H 14.5
    </StreamGeometry>

    <!-- System Mode Tab Icons (24x24 standard) -->
    <!-- Office Mode: Monitor with document lines -->
    <StreamGeometry x:Key="IconModeOffice">
        M 3,4 H 21 V 16 H 3 Z M 8,20 H 16 M 12,16 V 20 M 6,8 H 18 M 6,11 H 15 M 6,13 H 11
    </StreamGeometry>

    <!-- Gaming Mode: Console Gamepad Controller -->
    <StreamGeometry x:Key="IconModeGaming">
        M 6,8 H 18 A 4,4 0 0 1 22,12 C 22,17 19,20 17,20 C 15.5,20 14.5,18.5 13.5,17 H 10.5 C 9.5,18.5 8.5,20 7,20 C 5,20 2,17 2,12 A 4,4 0 0 1 6,8 Z M 6,12 H 10 M 8,10 V 14 M 16,11 A 1,1 0 1 0 16,13 A 1,1 0 0 0 16,11 Z M 18,13 A 1,1 0 1 0 18,15 A 1,1 0 0 0 18,13 Z
    </StreamGeometry>

    <!-- High Performance Mode: Tachometer at Redline -->
    <StreamGeometry x:Key="IconModePerformance">
        M 4,16 A 9,9 0 1 1 20,16 M 12,14 A 2,2 0 1 0 12,10 A 2,2 0 0 0 12,14 Z M 12,11 L 18,7.5 M 16,5 L 18,7 M 19,8 L 21,9
    </StreamGeometry>

    <!-- GPU Display Mode Card Illustrations -->
    <!-- Discrete GPU: Stylized multi-blade cooling turbine with GPU hub -->
    <StreamGeometry x:Key="IconGpuDiscrete">
        M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 Z M 12,2 C 14,5 14,7 12,7 M 19,5 C 18,8 16,9 15.5,8 M 22,12 C 19,14 17,14 17,12 M 19,19 C 16,18 15,16 15.5,15.5 M 12,22 C 10,19 10,17 12,17 M 5,19 C 6,16 8,15 8.5,16 M 2,12 C 5,10 7,10 7,12 M 5,5 C 8,6 9,8 8.5,8.5
    </StreamGeometry>

    <!-- MS Hybrid: Turbine on left linked to chip on right via curved arrows -->
    <StreamGeometry x:Key="IconGpuHybrid">
        M 7,7 A 4.5,4.5 0 1 1 7,16 A 4.5,4.5 0 1 1 7,7 Z M 15,8 H 21 V 15 H 15 Z M 15,11.5 H 21 M 18,8 V 15 M 7,5 C 10,3.5 14,4 16,6.5 M 14,6.5 H 17 V 3.5 M 17,17.5 C 14,20 10,19.5 7,18 M 9,18 H 6 V 21
    </StreamGeometry>

    <!-- UMA Mode: Semiconductor processor chip with lightning bolt -->
    <StreamGeometry x:Key="IconGpuUma">
        M 5,5 H 19 V 19 H 5 Z M 8,2 V 5 M 12,2 V 5 M 16,2 V 5 M 8,19 V 22 M 12,19 V 22 M 16,19 V 22 M 2,8 H 5 M 2,12 H 5 M 2,16 H 5 M 19,8 H 22 M 19,12 H 22 M 19,16 H 22 M 13,7 L 9,12.5 H 13 L 11,17 L 16,11.5 H 12 Z
    </StreamGeometry>

    <!-- Radio Indicator Geometries for Option Cards -->
    <StreamGeometry x:Key="IconRadioUnchecked">
        M 12,3 A 9,9 0 1 1 12,21 A 9,9 0 1 1 12,3 Z
    </StreamGeometry>
    <StreamGeometry x:Key="IconRadioChecked">
        M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 7.5,12 L 10.5,15 L 16.5,9
    </StreamGeometry>

    <!-- Window Caption Icons -->
    <StreamGeometry x:Key="IconMinimise">
        M 0,5 H 10
    </StreamGeometry>

    <StreamGeometry x:Key="IconClose">
        M 1,1 L 9,9 M 9,1 L 1,9
    </StreamGeometry>

    <!-- Lighting Effect Icons (24x24 viewBox standard) -->
    <!-- 1. Static: Constant luminescent glow -->
    <StreamGeometry x:Key="IconFxStatic">
        M 12,6 A 6,6 0 1 1 12,18 A 6,6 0 1 1 12,6 Z M 12,2 V 4 M 12,20 V 22 M 2,12 H 4 M 20,12 H 22
    </StreamGeometry>

    <!-- 2. Breathing: Smooth sinusoidal wave cycle -->
    <StreamGeometry x:Key="IconFxBreathing">
        M 2,12 C 5,2 8,2 12,12 C 16,22 19,22 22,12
    </StreamGeometry>

    <!-- 3. Blink: Digital square wave hard on / hard off -->
    <StreamGeometry x:Key="IconFxBlink">
        M 2,18 H 6 V 6 H 12 V 18 H 18 V 6 H 22
    </StreamGeometry>

    <!-- 4. Heartbeat: Sharp double-pulse ECG cardiogram -->
    <StreamGeometry x:Key="IconFxHeartbeat">
        M 1,13 H 5 L 7,8 L 10,19 L 13,4 L 16,16 L 18,13 H 23
    </StreamGeometry>

    <!-- 5. Colour cycle: Dual looping arrows -->
    <StreamGeometry x:Key="IconFxCycle">
        M 19.5,12 A 7.5,7.5 0 1 1 12,4.5 M 12,1 L 12,5 L 16,3 M 12,19.5 A 7.5,7.5 0 0 1 4.5,12 M 12,23 L 12,19 L 8,21
    </StreamGeometry>

    <!-- 6. Wave: Progressive ripples across keys -->
    <StreamGeometry x:Key="IconFxWave">
        M 2,8 C 5,3 8,13 12,8 C 16,3 19,13 22,8 M 2,16 C 5,11 8,21 12,16 C 16,11 19,21 22,16
    </StreamGeometry>

    <!-- Utility & Status Icons -->
    <StreamGeometry x:Key="IconReload">
        M 18.5,8 A 7,7 0 1 0 19,12 M 19,4 V 8.5 H 14.5
    </StreamGeometry>

    <StreamGeometry x:Key="IconStatusDot">
        M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 Z
    </StreamGeometry>

    <!-- Header Circuit Graphic Artwork (380x36 px copper PCB trace network) -->
    <DrawingGroup x:Key="HeaderCircuitArtwork">
        <!-- Layer 1: Dark base copper bus traces -->
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource CircuitDarkCopper}" Thickness="1.8" EndLineCap="Round" StartLineCap="Round" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <LineGeometry StartPoint="0,18" EndPoint="70,18" />
                    <LineGeometry StartPoint="70,18" EndPoint="86,6" />
                    <LineGeometry StartPoint="86,6" EndPoint="170,6" />
                    <LineGeometry StartPoint="170,6" EndPoint="186,18" />
                    <LineGeometry StartPoint="186,18" EndPoint="260,18" />
                    <LineGeometry StartPoint="30,26" EndPoint="110,26" />
                    <LineGeometry StartPoint="110,26" EndPoint="124,32" />
                    <LineGeometry StartPoint="124,32" EndPoint="220,32" />
                    <LineGeometry StartPoint="220,32" EndPoint="232,24" />
                    <LineGeometry StartPoint="232,24" EndPoint="320,24" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Layer 2: Mid copper signal traces -->
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource CircuitMidCopper}" Thickness="1.4" EndLineCap="Round" StartLineCap="Round" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <LineGeometry StartPoint="40,12" EndPoint="100,12" />
                    <LineGeometry StartPoint="100,12" EndPoint="112,22" />
                    <LineGeometry StartPoint="112,22" EndPoint="160,22" />
                    <LineGeometry StartPoint="160,22" EndPoint="174,10" />
                    <LineGeometry StartPoint="174,10" EndPoint="280,10" />
                    <LineGeometry StartPoint="280,10" EndPoint="292,16" />
                    <LineGeometry StartPoint="292,16" EndPoint="360,16" />
                    <LineGeometry StartPoint="130,16" EndPoint="148,4" />
                    <LineGeometry StartPoint="148,4" EndPoint="210,4" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Layer 3: Bright copper active traces -->
        <GeometryDrawing>
            <GeometryDrawing.Pen>
                <Pen Brush="{StaticResource CircuitBrightCopper}" Thickness="1.2" EndLineCap="Round" StartLineCap="Round" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <LineGeometry StartPoint="90,16" EndPoint="104,26" />
                    <LineGeometry StartPoint="104,26" EndPoint="150,26" />
                    <LineGeometry StartPoint="150,26" EndPoint="162,16" />
                    <LineGeometry StartPoint="162,16" EndPoint="240,16" />
                    <LineGeometry StartPoint="240,16" EndPoint="252,6" />
                    <LineGeometry StartPoint="252,6" EndPoint="340,6" />
                    <LineGeometry StartPoint="200,28" EndPoint="214,14" />
                    <LineGeometry StartPoint="214,14" EndPoint="290,14" />
                    <LineGeometry StartPoint="290,14" EndPoint="302,26" />
                    <LineGeometry StartPoint="302,26" EndPoint="370,26" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Layer 4: Hot copper nodes & via rings -->
        <GeometryDrawing Brush="{StaticResource CircuitHotCopper}">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <EllipseGeometry Center="86,6" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="170,6" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="112,22" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="160,22" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="240,16" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="280,10" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="214,14" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="290,14" RadiusX="2.5" RadiusY="2.5" />
                    <EllipseGeometry Center="340,6" RadiusX="2.8" RadiusY="2.8" />
                    <EllipseGeometry Center="360,16" RadiusX="2.8" RadiusY="2.8" />
                    <EllipseGeometry Center="370,26" RadiusX="2.8" RadiusY="2.8" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Layer 5: Accent test points -->
        <GeometryDrawing Brush="{StaticResource CircuitAccent}">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <EllipseGeometry Center="148,4" RadiusX="1.8" RadiusY="1.8" />
                    <EllipseGeometry Center="210,4" RadiusX="1.8" RadiusY="1.8" />
                    <EllipseGeometry Center="252,6" RadiusX="1.8" RadiusY="1.8" />
                    <EllipseGeometry Center="302,26" RadiusX="1.8" RadiusY="1.8" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <DrawingImage x:Key="HeaderCircuitImage" Drawing="{StaticResource HeaderCircuitArtwork}" />

</ResourceDictionary>
