    <!-- Recommended screen and sleep times -->
    <sys:String x:Key="S.Idle.Recommended">Önerilen süreler</sys:String>
    <sys:String x:Key="S.Idle.RecommendedTip">Her mod için mantıklı ekran ve uyku sürelerini ayarlar</sys:String>
    <sys:String x:Key="S.Idle.RecommendedTitle">Önerilen süreler ayarlansın mı?</sys:String>
    <sys:String x:Key="S.Idle.RecommendedBody" xml:space="preserve">Her moda şu ekran kapatma ve uyku süreleri yazılır (prizde / pilde):&#10;&#10;Güç Tasarrufu: ekran 5 / 3 dk, uyku 15 / 10 dk&#10;Dengeli (Ofis): ekran 10 / 5 dk, uyku 30 / 15 dk&#10;Oyun ve Performans: ekran 15 / 5 dk, uyku 60 / 15 dk&#10;&#10;Oyun ya da video ekranı kendisi açık tutar. Sonradan her birini değiştirebilirsiniz.</sys:String>

