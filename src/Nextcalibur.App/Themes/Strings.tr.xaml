    <sys:String x:Key="S.Heat.Body">Ağır bir şey çalışmıyorken bu sıcaklık sürüyorsa soğutucunun temizlenmesi gerekebilir.</sys:String>
    <sys:String x:Key="S.Heat.CpuBusy">İşlemciyi en çok kullananlar: {0}.</sys:String>
