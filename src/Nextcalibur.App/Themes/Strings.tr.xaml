    <!-- Scan for games, usage -->
    <sys:String x:Key="S.Settings.GameScanTitle">Oyunları tara</sys:String>
    <sys:String x:Key="S.Settings.GameScanDesc">Steam, Epic, GOG, Ubisoft, EA, Riot, Xbox ve Microsoft Store oyunlarını, ayrıca Windows'un oyun olarak tanıdığı programları bulur ve Oyun moduyla ekler. Anahtar açıkken yenileri günde bir kez aranır.</sys:String>
    <sys:String x:Key="S.Settings.GameScanButton">Tara</sys:String>
    <sys:String x:Key="S.Settings.GameScanAutoTip">Yeni kurulan oyunları günde bir kez ara</sys:String>
    <sys:String x:Key="S.Games.Result">{0} oyun bulundu, {1} tanesi listeye eklendi.</sys:String>
    <sys:String x:Key="S.Games.NoneFound">Başlatıcıların kayıtlarında oyun bulunamadı.</sys:String>
    <sys:String x:Key="S.Games.RulesOn">Program kuralları açıldı.</sys:String>
    <sys:String x:Key="S.Tour.Step.GameScanButton.Title">Oyunları tara</sys:String>
    <sys:String x:Key="S.Tour.Step.GameScanButton.Body">NVIDIA'nın uygulamasındaki gibi: kurulu oyunlar başlatıcıların kendi kayıtlarından bulunur ve çalışırken Oyun moduna geçirir. Başka bir programı - bir düzenleyici, uzun bir dışa aktarma - aşağıdan elle eklersiniz.</sys:String>
