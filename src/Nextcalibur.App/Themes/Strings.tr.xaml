    <sys:String x:Key="S.Core.Dependency.BadHash">İndirilen {0}, yayıncısının tarif ettiği dosya değil; kurulmadı.</sys:String>

    <!-- Windows'un kendi hataları -->
    <sys:String x:Key="S.Core.Fault.Unknown">{0}, birkaç dakikadır başka hiçbir şey meşgul değilken bir işlemci çekirdeğini tamamen kullanıyor. Nextcalibur ona dokunmadı - işini yapıyor olabilir.</sys:String>
    <sys:String x:Key="S.Core.Fault.InputHost">Windows'un giriş bileşeni (TextInputHost) bir işlemci çekirdeğini tamamen tüketir hâlde takılmıştı. Nextcalibur onu yeniden başlattı; dokunmatik klavye veya emoji paneli gerektiğinde Windows kendisi tekrar başlatır.</sys:String>
    <sys:String x:Key="S.WindowsFault.Fixed">Windows hatası giderildi</sys:String>
    <sys:String x:Key="S.WindowsFault.Found">Windows hatası bulundu</sys:String>
    <sys:String x:Key="S.WindowsFault.GpuWakeTitle">Ekran kartı uyanık tutuluyor</sys:String>
    <sys:String x:Key="S.WindowsFault.OpenGraphicsSettings">Grafik ayarları</sys:String>
    <sys:String x:Key="S.Core.Fault.GpuWake">Ekran kartı çizecek hiçbir şey yokken tam saat hızında uyanık ve yaklaşık {0} W güç harcıyor. Tutan işlemler: {1}.</sys:String>
    <sys:String x:Key="S.Core.Fault.GpuWakeNoProcesses">Ekran kartı çizecek hiçbir şey yokken tam saat hızında uyanık ve yaklaşık {0} W güç harcıyor.</sys:String>
    <sys:String x:Key="S.Settings.WindowsFaultsTitle">Bilinen Windows hatalarını telafi et</sys:String>
    <sys:String x:Key="S.Settings.WindowsFaultsDesc">Takılıp makineyi ısıtan birkaç bilinen Windows bileşenini izler ve yeniden başlatır. Ne yaptığını söyler.</sys:String>

    <!-- Tur: kartın sözleri, adım adım -->
    <sys:String x:Key="S.Tour.Finish">Bitir</sys:String>
    <sys:String x:Key="S.Tour.SkipTo">{0} bölümüne atla</sys:String>
    <sys:String x:Key="S.Tour.Section.Window">Pencere</sys:String>
    <sys:String x:Key="S.Tour.Section.Rail">Sol şerit</sys:String>
    <sys:String x:Key="S.Tour.Section.System">Sistem</sys:String>
    <sys:String x:Key="S.Tour.Section.Power">Güç Modu</sys:String>
    <sys:String x:Key="S.Tour.Section.Display">Ekran Modu</sys:String>
    <sys:String x:Key="S.Tour.Section.Lighting">Aydınlatma</sys:String>
    <sys:String x:Key="S.Tour.Section.Settings">Ayarlar</sys:String>
    <sys:String x:Key="S.Tour.Section.Readings">Okumalar</sys:String>
    <sys:String x:Key="S.Tour.Section.Tray">Tepsi</sys:String>

    <!-- Pencere -->
    <sys:String x:Key="S.Tour.Step.TourButton.Title">Nextcalibur'a hoş geldiniz</sys:String>
    <sys:String x:Key="S.Tour.Step.TourButton.Body">Bu, tur. Her sayfayı ve her denetimi teker teker gezer, tepsi simgesinde biter. Tur sürerken hiçbir şey değiştirilmez; yalnızca gösterir. İleri ve Geri ile ilerleyin; istediğiniz an Escape'e veya Atla'ya basıp çıkın. Bu düğme turu dilediğinizde yeniden başlatır.</sys:String>
    <sys:String x:Key="S.Tour.Step.TitleBar.Title">Başlık çubuğu</sys:String>
    <sys:String x:Key="S.Tour.Step.TitleBar.Body">Pencereyi taşımak için herhangi bir yerinden sürükleyin. Pencerenin tek bir sabit boyutu vardır; yeniden boyutlandırılacak bir şey yoktur.</sys:String>
    <sys:String x:Key="S.Tour.Step.ThemeSwitch.Title">Koyu, açık veya Windows'un seçimi</sys:String>
    <sys:String x:Key="S.Tour.Step.ThemeSwitch.Body">Üç görünüm: koyu, açık veya Windows ne seçtiyse o. Seçim hatırlanır.</sys:String>
    <sys:String x:Key="S.Tour.Step.MinimiseButton.Title">Simge durumuna küçült</sys:String>
    <sys:String x:Key="S.Tour.Step.MinimiseButton.Body">Pencereyi görev çubuğuna gönderir. Nextcalibur olduğu gibi çalışmaya devam eder; geri getirmek için görev çubuğundaki düğmeye tıklayın.</sys:String>
    <sys:String x:Key="S.Tour.Step.HideToTrayButton.Title">Tepsiye gizle</sys:String>
    <sys:String x:Key="S.Tour.Step.HideToTrayButton.Body">Pencereyi görev çubuğundan tamamen kaldırır. Uygulama saatin yanındaki bildirim alanında kalır, sensörleri okumayı ve modunuzu korumayı sürdürür; yeniden açmak için tepsi simgesine çift tıklayın.</sys:String>
    <sys:String x:Key="S.Tour.Step.CloseButton.Title">Kapat</sys:String>
    <sys:String x:Key="S.Tour.Step.CloseButton.Body">Çıkmak isteyip istemediğinizi sorar. Çıkmak Nextcalibur'u tamamen durdurur: yeniden başlatılana kadar okuma, aşırı ısınma uyarısı ve şarj takılıp çıkarılınca mod değişimi olmaz. Yalnızca gözünüzün önünden kalksın istiyorsanız tepsiye gizleyin.</sys:String>

    <!-- Sol şerit -->
    <sys:String x:Key="S.Tour.Step.NavSystem.Title">Sistem</sys:String>
    <sys:String x:Key="S.Tour.Step.NavSystem.Body">İlk sayfa: sistem modu, fanlar ve iki çip. Uygulamanın açıldığı sayfadır.</sys:String>
    <sys:String x:Key="S.Tour.Step.NavPower.Title">Güç Modu</sys:String>
    <sys:String x:Key="S.Tour.Step.NavPower.Body">Windows'un kendi güç modları, kart olarak; ve Windows'un seçtiğiniz moda uyup uymadığını sınayan bir denetim.</sys:String>
    <sys:String x:Key="S.Tour.Step.NavDisplay.Title">Ekran Modu</sys:String>
    <sys:String x:Key="S.Tour.Step.NavDisplay.Body">Ekranı hangi ekran kartının sürdüğü: yalnızca NVIDIA kartı, ikisi birlikte veya işlemcinin kendi grafiği.</sys:String>
    <sys:String x:Key="S.Tour.Step.NavLighting.Title">Aydınlatma</sys:String>
    <sys:String x:Key="S.Tour.Step.NavLighting.Body">Klavye arka ışığı: bölge başına renk, efektler, parlaklık ve kayıtlı profiller.</sys:String>
    <sys:String x:Key="S.Tour.Step.NavSettings.Title">Ayarlar</sys:String>
    <sys:String x:Key="S.Tour.Step.NavSettings.Body">Her tercih tek yerde; tepsi menüsündekilerle aynı ve onlarla eşzamanlı.</sys:String>
    <sys:String x:Key="S.Tour.Step.UpdateNowButton.Title">Güncellemeler</sys:String>
    <sys:String x:Key="S.Tour.Step.UpdateNowButton.Body">Daha yeni bir sürüm bulunana kadar "Güncel" yazar; izin verirseniz denetim arka planda sessizce yapılır. Yeni sürüm bulunduğunda düğme adını yazar; basınca güncelleme indirilir, doğrulanır, uygulanır ve uygulama yeni sürüm olarak yeniden açılır.</sys:String>
    <sys:String x:Key="S.Tour.Step.OpenLogButton.Title">Günlüğü aç</sys:String>
    <sys:String x:Key="S.Tour.Step.OpenLogButton.Body">Nextcalibur'un kendi günlüğünün bulunduğu klasörü açar: günde bir dosya, yedi gün saklanır, yalnızca olaylar - başlangıçlar, mod değişiklikleri, grafik geçişleri, güncellemeler, ters giden ne varsa. Sorun bildirirken bir tanesini ekleyin.</sys:String>
    <sys:String x:Key="S.Tour.Step.VersionText.Title">Sürüm</sys:String>
    <sys:String x:Key="S.Tour.Step.VersionText.Body">Çalıştırdığınız sürüm. Her bildirimde belirtin.</sys:String>

    <!-- Sistem -->
    <sys:String x:Key="S.Tour.Step.ModeOffice.Title">Office modu</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeOffice.Body">Sessiz ve serin: güç planı, Windows'un güç modu ve donanım yazılımının kendi profili hafif iş için ayarlanır. İzin verirseniz (bir tepsi ayarı) şarj çıkarıldığında Nextcalibur kendiliğinden Office'e geçer, takıldığında modunuza döner.</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeGaming.Title">Gaming modu</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeGaming.Body">Günlük hızlı mod. Donanım yazılımı Gaming profilini çalıştırır, Windows Dengeli veya Daha iyi performans modunu alır, işlemcinin yüklenmeler arasında yavaşlamasına izin verilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.ModePerformance.Title">Performance modu</sys:String>
    <sys:String x:Key="S.Tour.Step.ModePerformance.Body">Her şey açık: donanım yazılımının Performance profili ve Windows'un en hızlı modları. Daha gürültülü ve daha sıcak; fanlara değdiği zamanlar için.</sys:String>
    <sys:String x:Key="S.Tour.Step.SystemModeNote.Title">Modun anlamı</sys:String>
    <sys:String x:Key="S.Tour.Step.SystemModeNote.Body">Kartların altındaki satır seçili modun şu an ne yaptığını açıklar. Windows kartlardan hiçbirine uymayan bir moda alınmışsa tahmin etmek yerine bunu burada söyler.</sys:String>
    <sys:String x:Key="S.Tour.Step.SubtitleText.Title">Durum satırı</sys:String>
    <sys:String x:Key="S.Tour.Step.SubtitleText.Body">Etkin mod, dizüstünün şarjda mı pilde mi olduğu ve son sensör okumasının saati. Bir okuma başarısız olursa uydurma bir değer yerine "--" gösterilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.Banner.Title">Bildirim şeridi</sys:String>
    <sys:String x:Key="S.Tour.Step.Banner.Body">Yalnızca söylenecek bir şey olduğunda görünür: dizüstü desteklenmiyor, donanım yazılımı tuhaf yanıt verdi veya üreticinin yazılımı yan yana kurulu. Aksi hâlde ortada durmaz.</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuFanGauge.Title">İşlemcinin fanı</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuFanGauge.Body">Dakikadaki devir olarak fan hızı, donanım yazılımından okunur. Nextcalibur fan eğrisi ayarlamaz; modun seçtiği donanım yazılımı profili karar verir, tam olarak özgün yazılımın yaptığı gibi.</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuName.Title">İşlemci</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuName.Body">Makineden okunur, asla varsayılmaz.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuFanGauge.Title">Ekran kartının fanı</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuFanGauge.Body">İkinci fan, aynı kaynak. Kart uykudayken veya kapalıyken fan yalnızca durur.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuName.Title">Ekran kartı</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuName.Body">O da makineden okunur. UMA modunda kart devre dışıdır ama burası yine adını yazar.</sys:String>

    <!-- Güç Modu -->
    <sys:String x:Key="S.Tour.Step.PowerModeEfficiency.Title">En iyi güç verimliliği</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeEfficiency.Body">Windows'un pil tasarrufu modu. Yalnızca sistem modu Office iken sunulur; modunuzun aralığı dışındaki kartlar soluklaşır, böylece hızlı bir mod yavaş bir profille (ya da tersi) eşleşemez.</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBalanced.Title">Dengeli</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBalanced.Body">Windows'un varsayılanı. Office ve Gaming'de kullanılabilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBetter.Title">Daha iyi performans</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBetter.Body">Gaming ve Performance'ta kullanılabilir. Bir sistem modu seçmek burada her zaman o modun kendi varsayılanını seçer; bu kartlar bir adım öteye ya da beriye yaslanmanızı sağlar.</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBest.Title">En iyi performans</sys:String>
    <sys:String x:Key="S.Tour.Step.PowerModeBest.Body">Windows'un en hızlı modu, yalnızca Performance için. Nextcalibur bunun üstünde bir koruma tutar: dizüstü boştayken bu mod işlemciyi artık tam hızda tutamaz - özgün yazılımın geride bıraktığı kusur buydu.</sys:String>
    <sys:String x:Key="S.Tour.Step.OverlayState.Title">Windows moda uyuyor mu?</sys:String>
    <sys:String x:Key="S.Tour.Step.OverlayState.Body">Windows'un güç katmanının seçtiğiniz modla karşılaştırılması. Yeşil, her şey yolunda demektir.</sys:String>
    <sys:String x:Key="S.Tour.Step.OverlayDetail.Title">Ne buldu</sys:String>
    <sys:String x:Key="S.Tour.Step.OverlayDetail.Body">Açıklama, sade sözcüklerle: Windows ne yapıyor ve neden önemli.</sys:String>
    <sys:String x:Key="S.Tour.Step.FixButton.Title">Onar</sys:String>
    <sys:String x:Key="S.Tour.Step.FixButton.Body">Yalnızca denetim bir sorun bulduğunda görünür. Basınca güç ayarları düzeltilir; başka hiçbir şeye dokunulmaz.</sys:String>

    <!-- Ekran Modu -->
    <sys:String x:Key="S.Tour.Step.ModeDiscrete.Title">Discrete</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeDiscrete.Body">Ekranı yalnızca NVIDIA kartı sürer: en çok performans, en çok güç. Grafik modunu değiştirmek yeniden başlatma ister ve geçiş donanım yazılımına ancak Windows gerçekten yeniden başlarken yazılır - yeniden başlatmayı iptal ederseniz hiçbir şey değişmemiştir.</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeHybrid.Title">Hybrid</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeHybrid.Body">İkisi birden: ekranı işlemcinin grafiği sürer, NVIDIA kartı oyunlar ve ağır işler için uyanır, aralarda uyur. Olağan seçim.</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeUma.Title">UMA</sys:String>
    <sys:String x:Key="S.Tour.Step.ModeUma.Body">Yalnızca işlemcinin grafiği; en uzun pil ömrü için NVIDIA kartı tamamen kapatılır. Diğer ikisinden farklı olarak hemen etkili olur, yeniden başlatma gerekmez.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuRestartPending.Title">Bir değişiklik bekliyor</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuRestartPending.Body">Discrete veya Hybrid seçildikten sonra bu satır yeniden başlatmaya kadar kalır. Yeniden başlatmadan Nextcalibur'dan çıkmak bekleyen değişikliği düşürür.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuModeDetail.Title">Kart ne yapıyor</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuModeDetail.Body">Kart uyanıkken saat hızı ve güç tüketimi; Windows kapattığında "uykuda". Nextcalibur uyku durumunu Windows'un kendi kayıtlarından okur, böylece bakmak kartı asla uyandırmaz.</sys:String>

    <!-- Aydınlatma -->
    <sys:String x:Key="S.Tour.Step.LedPower.Title">Aydınlatma açık veya kapalı</sys:String>
    <sys:String x:Key="S.Tour.Step.LedPower.Body">Klavye arka ışığını tamamen kapatır ya da her şey olduğu gibi geri açar. Klavyedeki Fn+Space parlaklığı kademeli değiştirmeye devam eder ve sayfa bunu izler.</sys:String>
    <sys:String x:Key="S.Tour.Step.TabZoneA.Title">Bölgeler</sys:String>
    <sys:String x:Key="S.Tour.Step.TabZoneA.Body">Klavye soldan sağa üç bölgede ışır. O bölgeyi renklendirmek için sekmesini seçin; üstündeki çizim ayarlananı gösterir.</sys:String>
    <sys:String x:Key="S.Tour.Step.SelectAll.Title">Tüm bölgeler birden</sys:String>
    <sys:String x:Key="S.Tour.Step.SelectAll.Body">İşaretleyin; seçtiğiniz renk ve efekt üç bölgeye birlikte gider.</sys:String>
    <sys:String x:Key="S.Tour.Step.ProfileRow.Title">Profiller</sys:String>
    <sys:String x:Key="S.Tour.Step.ProfileRow.Body">Dört kayıtlı aydınlatma kümesi: Office, Gaming, Performance ve kendinize ait bir tane. Bir profil seçmek onu uygular; sonra değiştirdiğiniz her şey ona kaydedilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.EffectPanel.Title">Efektler</sys:String>
    <sys:String x:Key="S.Tour.Step.EffectPanel.Body">Sabit, nefes, yanıp sönme, kalp atışı, renk döngüsü ve dalga. Son ikisi kendi renklerini üretir; onlar seçiliyken tekerlek soluklaşır.</sys:String>
    <sys:String x:Key="S.Tour.Step.Wheel.Title">Renk tekerleği</sys:String>
    <sys:String x:Key="S.Tour.Step.Wheel.Body">Seçili bölge için bir renk seçmek üzere tıklayın veya sürükleyin. Değişiklik bıraktığınız an klavyeye gönderilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.BrightnessSlider.Title">Parlaklık</sys:String>
    <sys:String x:Key="S.Tour.Step.BrightnessSlider.Body">Seçilen renkleri kısar. Fn+Space donanımın kendi üç kademesini adımlar; ikisi de burada tek bir yüzde olarak gösterilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.ReloadButton.Title">Yeniden yükle</sys:String>
    <sys:String x:Key="S.Tour.Step.ReloadButton.Body">Kayıtlı aydınlatmayı klavyeye yeniden gönderir; başka bir şey sıfırladıysa işe yarar.</sys:String>

    <!-- Ayarlar -->
    <sys:String x:Key="S.Tour.Step.SettingWinUtilButton.Title">WinUtil</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingWinUtilButton.Body">Chris Titus Tech'in WinUtil aracını - bir Windows sadeleştirme ve ince ayar aracı - yazarının sitesinden indirip yönetici PowerShell'de açar. Nextcalibur'un parçası değildir; açılmadan önce size sorulur.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingDriversButton.Title">Sürücüler</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingDriversButton.Body">Dizüstü üreticisinin kendi sürücü indirme sayfasını tarayıcınızda açar; Nextcalibur'un dağıtmadığı donanım yazılımı, yonga seti ve klavye sürücülerinin yeri.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingReportButton.Title">Sorun bildir</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingReportButton.Body">Projenin GitHub'daki issues sayfasını açar. Günün günlüğünü ekleyin (sol altta Günlüğü aç) ve hangi sürümü çalıştırdığınızı yazın; sürüm düğmelerin altındadır.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingPrivacyButton.Title">Gizlilik</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingPrivacyButton.Body">Uygulamanın verilerle ne yaptığı, kendi sözcükleriyle: hiçbir şey toplanmaz, hakkınızda hiçbir şey gönderilmez; tek istekler güncellemeler için GitHub'a gider, otomatik denetim kapalıyken hiç gitmez. Tam metin bir tık ötededir.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingStartWithWindows.Title">Windows ile başlat</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingStartWithWindows.Body">Nextcalibur'u oturum açılınca yönetici olarak, sormadan başlatır - zamanlanmış bir görevle; yönetici bir programın Windows ile başlamasının tek yolu budur.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingOfficeOnBattery.Title">Pilde Office modu</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingOfficeOnBattery.Body">Şarj çıkarıldığında Office'e düş; takıldığında önceki moda dön. Varsayılan olarak açık, özgün yazılımın yaptığı gibi.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingOverheatWarning.Title">Aşırı ısınma uyarısı</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingOverheatWarning.Body">Okumalar panelindeki anahtarın aynısı: çiplerden biri eşiğini aştığında tepsiden bir uyarı. Eşiklerin kendisi sıcaklıkların yanındadır.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingInterval2.Title">Sensörler ne sıklıkla okunsun</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingInterval2.Body">Saniyede bir, iki, beş veya on saniyede bir okuma. Her okuma bir donanım yazılımı çağrısıdır; iki saniye varsayılandır ve bir çekirdeğin yüzde onda birine mal olur.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingAutoCheckUpdates.Title">Güncellemeleri otomatik denetle</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingAutoCheckUpdates.Body">Başlangıçtan bir dakika sonra ve her altı saatte bir GitHub'a küçük bir istek. Bulunan sürüm önerilir, kendiliğinden kurulmaz - bir sonraki anahtar açık değilse.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingAutoInstallUpdates.Title">Güncellemeleri otomatik kur</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingAutoInstallUpdates.Body">Bir adım daha ileri gider: bulunan sürüm sormadan indirilir, doğrulanır, kurulur ve uygulama yeni sürümle yeniden başlar. Varsayılan olarak kapalı. Yeniden başlatma bekleyen bir grafik değişikliği varsa bekler; o yeniden başlatmanın zamanı sizindir.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingLanguageEnglish.Title">Dil</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingLanguageEnglish.Body">İngilizce veya Türkçe; anında uygulanır ve hatırlanır. İlk açılışta Windows'un dili alınır.</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingCheckNowButton.Title">Şimdi denetle</sys:String>
    <sys:String x:Key="S.Tour.Step.SettingCheckNowButton.Body">GitHub'a hemen sorar ve yanıtı her durumda söyler.</sys:String>

    <!-- Okumalar -->
    <sys:String x:Key="S.Tour.Step.CpuClock.Title">İşlemci, canlı</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuClock.Body">Gigahertz olarak saat hızı ve PawnIO sürücüsü kurulu Intel makinelerde watt olarak paket gücü. Birkaç saniyede bir okunur; aralık bir tepsi ayarıdır.</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuTemp.Title">İşlemci sıcaklığı</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuTemp.Body">Donanım yazılımının kendi sensöründen - fanların uyduğu sensörün aynısı.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuClock.Title">Ekran kartı, canlı</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuClock.Body">Kart uyanıkken saat ve watt; değilken "uykuda". Nextcalibur sormak için kartı asla uyandırmaz.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuTemp.Title">Ekran kartı sıcaklığı</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuTemp.Body">Donanım yazılımından; bu yüzden kartın kendi sürücüsü yokken bile vardır.</sys:String>
    <sys:String x:Key="S.Tour.Step.OverheatWarningToggle.Title">Aşırı ısınma uyarısı</sys:String>
    <sys:String x:Key="S.Tour.Step.OverheatWarningToggle.Body">Açıkken çiplerden biri eşiğini aşarsa tepsiden bir uyarı görünür. Yalnızca uyarıdır; Nextcalibur hiçbir şeyi kısmaz.</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuWarnSlider.Title">İşlemci eşiği</sys:String>
    <sys:String x:Key="S.Tour.Step.CpuWarnSlider.Body">Kaydırıcıyı sürükleyin veya kutuya tam sayı yazın. Aralık dışı değerler sınırlanmaz, reddedilir.</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuWarnSlider.Title">Ekran kartı eşiği</sys:String>
    <sys:String x:Key="S.Tour.Step.GpuWarnSlider.Body">Kart için aynısı. Varsayılanlar bu sınıf dizüstüler için güvenli değerlerdir.</sys:String>
    <sys:String x:Key="S.Tour.Step.OverheatResetButton.Title">Sıfırla</sys:String>
    <sys:String x:Key="S.Tour.Step.OverheatResetButton.Body">İki eşiği de varsayılanlarına döndürür.</sys:String>
    <sys:String x:Key="S.Tour.Step.RamGauge.Title">Bellek</sys:String>
    <sys:String x:Key="S.Tour.Step.RamGauge.Body">Takılı belleğin ne kadarının kullanımda olduğu, Windows'tan saniyede bir okunur.</sys:String>
    <sys:String x:Key="S.Tour.Step.DriveList.Title">Diskler</sys:String>
    <sys:String x:Key="S.Tour.Step.DriveList.Body">Makinedeki her sabit disk, her biri kendi göstergesiyle. Dakikada bir okunur; bir diskin kullanımı bundan hızlı değişmez.</sys:String>

    <!-- Tepsi -->
    <sys:String x:Key="S.Tour.Step.TrayIcon.Title">Tepsi simgesi</sys:String>
    <sys:String x:Key="S.Tour.Step.TrayIcon.Body">Nextcalibur saatin yanındaki bildirim alanında yaşar; menüsü az önce orada açıldı. Nextcalibur'u aç pencereyi geri getirir. Windows ile başlat oturum açılınca yönetici olarak, sormadan başlatır. Pilde Office modu şarj çıkarıldığındaki otomatik geçiştir. CPU veya GPU ısınınca uyar aşırı ısınma uyarısıdır. Sensörleri okuma sıklığı sayıların ne sıklıkla yenileneceğini belirler. Güncellemeleri otomatik denetle, Güncellemeleri otomatik kur ve Güncellemeleri şimdi denetle adları ne diyorsa odur; Ayarlar sayfasında aynı anahtarlar vardır. Günlük klasörünü aç, Günlüğü aç düğmesiyle aynıdır. Çıkış uygulamayı durdurur - durmasının tek yolu budur. Hepsi bu kadar. Makinenin tadını çıkarın.</sys:String>
</ResourceDictionary>
