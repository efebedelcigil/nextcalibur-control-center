<Configuration>
  <!-- The installer wizard, tried by hand on a clean Windows. The wizard is
       mapped in and started with /skipnvidia=1, because a virtual machine
       has no NVIDIA driver and the wizard refuses to install without one
       everywhere else. The person drives it from there. -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\efeva\Desktop\Nextcalibur\installer\output</HostFolder>
      <SandboxFolder>C:\Setup</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <Networking>Enable</Networking>
  <LogonCommand>
    <Command>cmd.exe /c for %f in (C:\Setup\Nextcalibur-Setup-*.exe) do start "" "%f" /skipnvidia=1</Command>
  </LogonCommand>
</Configuration>
